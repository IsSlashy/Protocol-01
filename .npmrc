shamefully-hoist=true
public-hoist-pattern[]=*
node-linker=hoisted

# Windows reliability knobs (added 2026-05-27 after V8 crash on hoisted install).
# Hoisted mode dumps 1400+ entries flat at the root; combined with Windows
# Defender real-time scan this caused partial-write corruption of package.json
# files. Lowering parallelism trades ~30% install time for elimination of the
# race. Pair with the Defender exclusions on D:\Protocol-01 and D:\.pnpm-store.
child-concurrency=3
network-concurrency=8
