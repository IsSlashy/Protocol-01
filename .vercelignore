circuits/
**/*.ptau
**/*.zkey
**/*.r1cs
**/*.sym
**/*.wasm.tmp
circuits/**/build

# Backend services (local-only dev backends — not Vercel targets)
services/

# Android / native
**/.cxx
**/.gradle
apps/mobile/android/app/build
apps/mobile/android/app/build2
apps/mobile/android/build
**/build2
apps/mobile/ios/build
apps/mobile/ios/Pods

# Heavy media / release artifacts (over Vercel's 100 MB CLI upload limit).
# Scope the .mp4 ignore to the weekly-update renders — a blanket **/*.mp4 also
# stripped the website's own content videos (apps/web/public/*.mp4 + /videos),
# which 404'd the homepage demo + update clips on production.
apps/weekly-update/out
apps/weekly-update/**/*.mp4
**/*.wav
**/*.apk
**/*.aab

# Secrets / keypairs (never deploy)
**/.secrets/
.secrets/
**/*.keypair.json
**/*-keypair.json
**/keypair.json
**/id.json
*.key
*.pem
*.p12
*.jks
*.pfx
*.keystore

# Environment files (defensive — Vercel handles env separately)
.env
.env.*
!.env.example
!.env.*.example
.env.local
.env.*.local

# IDE / editor
.vscode
.idea
**/.DS_Store

# AI / agent configs
.claude/
**/.agents/

# Misc
.git
*.log
coverage
.env*.local

# Vercel local
.vercel
apps/*/.vercel
