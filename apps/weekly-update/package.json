{
  "name": "weekly-update",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "remotion studio",
    "build": "echo 'weekly-update: build is a no-op; use pnpm render to produce the video' && exit 0",
    "render:chunked": "node scripts/render-chunked.mjs",
    "render:styx": "node scripts/render-chunked.mjs StyxPitch out/styx-pitch.mp4 --total=7200 --audio=styx-bed.wav",
    "render:speed": "node scripts/render-chunked.mjs StyxSpeed out/styx-speed.mp4 --total=2700 --audio=styx-bed.wav"
  },
  "dependencies": {
    "@remotion/cli": "4.0.524",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "remotion": "4.0.524",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.15",
    "typescript": "^5.9.3"
  }
}
