# Environment Configuration for Protocol 01 Web App
# Copy this file to .env.local and fill in the actual values

# ============================================================================
# Vercel KV Database
# ============================================================================
# Vercel KV (Upstash Redis) is used for:
#   - the whitelist of approved developer wallets
#   - the phone->extension pairing relay (app/api/pair/[id], lib/pairStore.ts):
#     holds the one-time ENCRYPTED seed blob for ~180s. Without these vars it
#     falls back to an in-memory map that is NOT durable on Vercel (every
#     serverless isolate has its own) — prod MUST set these.
# Get these from your Vercel project dashboard (or an Upstash KV).
# (UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN are also accepted.)
KV_REST_API_URL=https://your-project-name.kv.vercel.sh
KV_REST_API_TOKEN=your_kv_rest_api_token_here

# ============================================================================
# Email Service (Resend)
# ============================================================================
# Resend is used to send approval emails to whitelisted developers
# Get your API key from https://resend.com
RESEND_API_KEY=re_YOUR_API_KEY_HERE

# Email address used in the "from" field for approval emails
EMAIL_FROM=Protocol 01 <noreply@yourcompany.com>

# ============================================================================
# Discord Integration
# ============================================================================
# Discord webhook URL for sending approval notifications to your admin channel
# Create a webhook in Discord server settings > Integrations > Webhooks
DISCORD_WEBHOOK=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# ============================================================================
# Admin Authentication
# ============================================================================
# Password used to protect sensitive admin endpoints (whitelist management)
# Set a strong, random password and keep it secure
ADMIN_PASSWORD=your_strong_admin_password_here

# ============================================================================
# Discord Bot (SDK Demo)
# ============================================================================
# Public Discord webhook for SDK demo interactions
# This is safe to be public since it only accepts demo requests
NEXT_PUBLIC_DISCORD_WEBHOOK=https://discord.com/api/webhooks/YOUR_PUBLIC_WEBHOOK_ID/YOUR_PUBLIC_WEBHOOK_TOKEN

# ============================================================================
# Waitlist (double opt-in email signup)
# ============================================================================
# Reuses the KV (Upstash Redis) and Resend config above:
#   - KV stores the pending/confirmed records (prod requires KV_REST_API_URL +
#     KV_REST_API_TOKEN, or the UPSTASH_* equivalents; without them signup
#     returns 503 in production).
#   - RESEND_API_KEY / EMAIL_FROM send the confirmation email. If Resend is
#     missing the signup is still stored and a mail-failure counter is bumped.
# See WAITLIST.md for the full runbook and Redis key map.

# Bearer token for the admin-only /api/waitlist/stats and /export endpoints
# (Authorization: Bearer <token>). Also used as the salt when hashing IPs for
# per-IP rate limiting, so set a strong, random value. ADMIN_PASSWORD (above)
# is also accepted via the x-admin-password header on those endpoints.
WAITLIST_STATS_TOKEN=your_strong_random_stats_token_here

# Absolute base URL used to build confirm/unsubscribe links inside emails.
# Defaults to https://protocol-01.dev when unset.
SITE_URL=https://protocol-01.dev
