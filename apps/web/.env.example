# Environment Configuration for Protocol 01 Web App
# Copy this file to .env.local and fill in the actual values

# ============================================================================
# Vercel KV Database
# ============================================================================
# Vercel KV (Upstash Redis) is used for:
#   - the whitelist of approved developer wallets
#   - the phone->extension pairing relay (app/api/pair/[id], lib/pairStore.ts):
#     holds the one-time ENCRYPTED seed blob for ~180s. Without these vars it
#     falls back to an in-memory map that is NOT durable on Vercel (every
#     serverless isolate has its own) — prod MUST set these.
# Get these from your Vercel project dashboard (or an Upstash KV).
# (UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN are also accepted.)
KV_REST_API_URL=https://your-project-name.kv.vercel.sh
KV_REST_API_TOKEN=your_kv_rest_api_token_here

# ============================================================================
# Email Service (Resend)
# ============================================================================
# Resend is used to send approval emails to whitelisted developers
# Get your API key from https://resend.com
RESEND_API_KEY=re_YOUR_API_KEY_HERE

# Email address used in the "from" field for approval emails
EMAIL_FROM=Protocol 01 <noreply@yourcompany.com>

# ============================================================================
# Discord Integration
# ============================================================================
# Discord webhook URL for sending approval notifications to your admin channel
# Create a webhook in Discord server settings > Integrations > Webhooks
DISCORD_WEBHOOK=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# ============================================================================
# Admin Authentication
# ============================================================================
# Password used to protect sensitive admin endpoints (whitelist management)
# Set a strong, random password and keep it secure
ADMIN_PASSWORD=your_strong_admin_password_here

# ============================================================================
# Discord Bot (SDK Demo)
# ============================================================================
# Public Discord webhook for SDK demo interactions
# This is safe to be public since it only accepts demo requests
NEXT_PUBLIC_DISCORD_WEBHOOK=https://discord.com/api/webhooks/YOUR_PUBLIC_WEBHOOK_ID/YOUR_PUBLIC_WEBHOOK_TOKEN

# ============================================================================
# Waitlist (double opt-in email signup)
# ============================================================================
# Reuses the KV (Upstash Redis) and Resend config above:
#   - KV stores the pending/confirmed records (prod requires KV_REST_API_URL +
#     KV_REST_API_TOKEN, or the UPSTASH_* equivalents; without them signup
#     returns 503 in production).
#   - RESEND_API_KEY / EMAIL_FROM send the confirmation email. If Resend is
#     missing the signup is still stored and a mail-failure counter is bumped.
# See WAITLIST.md for the full runbook and Redis key map.

# Bearer token for the admin-only /api/waitlist/stats and /export endpoints
# (Authorization: Bearer <token>). Also used as the salt when hashing IPs for
# per-IP rate limiting, so set a strong, random value. ADMIN_PASSWORD (above)
# is also accepted via the x-admin-password header on those endpoints.
WAITLIST_STATS_TOKEN=your_strong_random_stats_token_here

# Absolute base URL used to build confirm/unsubscribe links inside emails.
# Defaults to https://protocol-01.dev when unset.
SITE_URL=https://protocol-01.dev

# ============================================================================
# Starknet (/pay PQ stealth — pq_announcer transport)
# ============================================================================
# Injected into pay-core via configureStarknet() in components/pay/PayApp.tsx.
# If NEXT_PUBLIC_PQ_ANNOUNCER_ADDRESS is unset, isStarknetConfigured() is false
# and the /pay UI shows all Starknet assets as coming-soon (send gated, scan
# empty). Contract is e2e-proven on local starknet-devnet only; Sepolia deploy
# pending. See contracts/starknet/ARCHITECTURE.md.

# Starknet JSON-RPC node url. Defaults to the public Sepolia endpoint
# (https://starknet-sepolia-rpc.publicnode.com) when unset.
NEXT_PUBLIC_STARKNET_RPC_URL=https://starknet-sepolia-rpc.publicnode.com

# Address of the deployed pq_announcer contract on the target network.
# Unset = Starknet assets show as coming-soon.
NEXT_PUBLIC_PQ_ANNOUNCER_ADDRESS=0xYOUR_DEPLOYED_PQ_ANNOUNCER_ADDRESS

# Account class hash used to derive counterfactual stealth account addresses.
# Optional: defaults to the OpenZeppelin account class hash (v0.8.1,
# predeclared on starknet-devnet and widely deployed on Sepolia). Override
# only for a different account implementation.
NEXT_PUBLIC_STARKNET_ACCOUNT_CLASS_HASH=

# ============================================================================
# The shielded pool: the treasury, the funder, and the till
# ============================================================================
# None of these were documented here, and every one of them fails SILENTLY at
# the point of use: the client catches the failure, falls back to the user's
# wallet, and the operation succeeds with the wallet on chain -- which is the
# one outcome this machinery exists to prevent. Ask the deployment before you
# demo it:  GET /api/fund-ephemeral?readiness=1
#
# ---------------------------------------------------------------------------
# R AND F MUST BE DIFFERENT ADDRESSES. This is the whole game.
# ---------------------------------------------------------------------------
# On 2026-08-18 a subscription passed every probe but P11, and the walk was two
# hops with no cryptography in it:
#
#     subscription -> its fee payer (a fresh ephemeral)
#                  -> whoever funded that ephemeral      = F
#                  -> F's own transaction history        -> a transfer SIGNED
#                     BY THE BUYER, one second earlier, for exactly the note's
#                     amount.
#
# Neither transfer named both ends. F, standing between them, named both. A
# detour moves a name one step away; it does not remove it, and the clock puts
# back together what the topology took apart.
#
#   R = the till.  Collects money from buyers. NEVER funds an ephemeral, NEVER
#                  deposits a note.
#   F = the float. Deposits inventory ahead of time and funds the spends.
#                  NEVER receives a payment from a buyer.
#
# R and F may settle with each other -- in large batches, on a schedule that has
# nothing to do with any single purchase. One transfer per purchase is the same
# leak wearing a second address, and readiness reports it as such.

# F's secret key, base58. This address pays proof-buffer rent and fees for every
# job, and the residue sweeps back to it. Devnet only: the route refuses to run
# against any cluster whose genesis hash is not devnet's.
P01_FUNDER_SECRET_KEY=base58_secret_key_here

# R's PUBLIC key, base58 -- the address buyers pay. Only the public half, on
# purpose: this deployment must not be ABLE to spend from the till, so it cannot
# accidentally make the till pay for a job. Declaring it buys one thing, and it
# is the important one: the funder route REFUSES to serve when R and F are the
# same address, instead of producing a subscription that looks private and is
# walkable in two hops.
# Leaving it unset is not "fine by default" -- readiness reports it as a reason,
# because a deployment that cannot answer R != F cannot claim the property.
P01_TILL_ADDRESS=base58_public_key_here

# The operator's 1% sink -- a THIRD address, public key only, distinct from both
# R and F. The fee is an extra SystemProgram.transfer inside the same
# transaction the buyer already signs: one signature, two credits, and the note
# that reaches the pool stays EXACTLY the denomination because the fee never
# passes through it.
#
# ⛔ IT IS A SINK. It only ever receives.
# The fee rides in the buyer's own transaction, so this address is CO-NAMED WITH
# EVERY BUYER -- getSignaturesForAddress on it enumerates every customer this
# deployment has served. That is survivable only while nothing it touches leads
# onward. The moment it funds an ephemeral (or F funds it), probe P11 walks
# fee wallet -> ephemeral -> subscription and lands back on a buyer, and the
# R != F split is undone by what looks like an accounting convenience.
# /api/fund-ephemeral refuses to fund it, and both routes refuse to serve when
# it equals F or R -- the second collision is the silent one, because web3.js
# merges an identical pubkey into ONE account index, so the relay would read
# value + fee as the payment and no fee would ever be collected.
#
# Unset means a relayed deposit REFUSES before the buyer signs anything. That is
# deliberate: the alternative is a deposit that quietly becomes the linkable
# kind, which the buyer cannot detect afterwards and cannot undo.
P01_FEE_WALLET=base58_public_key_here

# Shared secret gating the funder route, so it is not an open faucet.
# BOTH are needed and they are NOT interchangeable:
#   P01_FUNDER_TICKET             read by the server at request time.
#   NEXT_PUBLIC_P01_FUNDER_TICKET INLINED INTO THE BROWSER BUNDLE AT BUILD TIME.
# Setting the second without REDEPLOYING ships a bundle that never calls the
# funder at all, and every job silently falls back to the user's wallet. No
# server can detect that; readiness names it as a blind spot rather than
# pretending otherwise.
P01_FUNDER_TICKET=a_long_random_string
NEXT_PUBLIC_P01_FUNDER_TICKET=the_same_long_random_string

# The RPC the server side uses. Without it the public endpoint is used, which
# rate-limits (429) and then goes quiet for minutes -- long enough to look like
# a hung app. Point it at a real provider.
P01_FUNDER_RPC=https://your-provider.example/devnet

# ---------------------------------------------------------------------------
# Pre-deposited inventory: the only purchase path that is clean by construction
# ---------------------------------------------------------------------------
# The buyer makes NO on-chain payment, so there is nothing to correlate. The
# treasury deposits notes AHEAD of time and hands out a claim code.
#
# The depositing address must NOT be F either: one treasury on both the deposit
# and the spend leg is exactly what probe P8 reports, and it is fatal to the
# claim being demonstrated.

# 64 hex characters. The HKDF seed every inventory note is derived from.
# Losing it loses the notes: nothing else can rebuild their secrets.
P01_TREASURY_POOL_SEED=64_hex_characters_here

# Comma-separated leaf indices of the notes deposited from the treasury.
# EXTEND THIS AFTER EVERY DEPOSIT AND REDEPLOY -- a note that is on the tree but
# not listed here does not exist as far as the issuer is concerned, and the
# answer a buyer gets is "the note inventory is empty".
P01_TREASURY_NOTE_LEAVES=26,30

# The denomination those leaves were deposited at, and the pool they live in.
P01_TREASURY_NOTE_DENOMINATION=1

# How old a deposit must be before it may be handed out, in slots (~0.4s each).
# 9000 slots is about an hour. This is a PRIVACY parameter, not a tuning knob: a
# note deposited moments before it is sold carries the clock of whoever bought
# it, and no crowd dilutes a one-second window.
P01_TREASURY_NOTE_MIN_AGE_SLOTS=9000

# Mints claim codes. Separate from the funder ticket ON PURPOSE: that ticket
# ships in the browser bundle, so anyone who reads the bundle could otherwise
# mint themselves unlimited notes. This one never leaves the server.
P01_CLAIM_MINT_SECRET=another_long_random_string

# Notes issued per IP per hour.
P01_ISSUE_LIMIT_PER_HOUR=12
