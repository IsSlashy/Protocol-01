{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm --filter @protocol-01/mugen... build",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/treasury-buffer-tick",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/noise-tick",
      "schedule": "* * * * *"
    }
  ]
}
