{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "bash scripts/vercel-install.sh",
  "buildCommand": "cd ../.. && pnpm -F @protocol-01/mugen build",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/treasury-buffer-tick",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/noise-tick",
      "schedule": "0 0 * * *"
    }
  ]
}
