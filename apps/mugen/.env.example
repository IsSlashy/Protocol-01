# ── Mugen Exchange — environment variables ──────────────────────────────────
# Copy to .env.local for local dev. Set all non-optional vars in the Vercel
# dashboard (Production + Preview + Development scopes) before deploy.
#
# To populate the *_B64 keypair vars from your local .secrets/ files, run:
#   pnpm -F @protocol-01/mugen env:export-keypairs
# and copy the printed values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Public (client-side, safe to expose) ─────────────────────────────────────
# Solana RPC consumed by browser code (exchange, pay, trade pages).
# Use a Helius devnet/mainnet URL with API key for production.
NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com

# Public base URL of the Mugen API (set to the Vercel deployment URL in prod).
NEXT_PUBLIC_MUGEN_API=https://mugen.vercel.app

# ── Server: Solana RPC ───────────────────────────────────────────────────────
# Server-side RPC used by all /api/** routes. Must be reliable (public devnet
# rate-limits aggressively). Recommend Helius/Triton.
SOLANA_RPC_URL=https://api.devnet.solana.com

# ── Server: Keypairs (base64 of 64-byte secretKey) ───────────────────────────
# Relayer (pays tx fees, signs Arcium MPC submissions).
# Accepts either base64 or a filesystem path (legacy). On Vercel use base64.
# Local dev fallback: ~/.config/solana/id.json
MUGEN_RELAYER_KEYPAIR=

# Taker escrow signer. Local dev fallback: apps/mugen/.secrets/taker-keypair.json
MUGEN_TAKER_KEYPAIR_B64=

# Treasury buffer signer. Local dev fallback: apps/mugen/.secrets/treasury-buffer-keypair.json
MUGEN_TREASURY_BUFFER_KEYPAIR_B64=

# Noise wallet pool (JSON array of 5 base64 strings).
# Local dev fallback: apps/mugen/.secrets/noise-wallet-{0..4}.keypair.json
MUGEN_NOISE_WALLETS_B64=

# ── Server: Persistent storage (Upstash Redis / Vercel KV) ───────────────────
# REQUIRED FOR PRODUCTION. Without these, the app falls back to in-memory
# storage — unsafe on Vercel (maker+taker land on different serverless
# instances → trades never match).
#
# Option A — Vercel KV (Marketplace → Upstash): sets these automatically.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Option B — standalone Upstash Redis: set these instead.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Server: Cron authentication ──────────────────────────────────────────────
# Vercel sets the x-vercel-cron header automatically on scheduled invocations;
# CRON_SECRET is for manual tick triggers (curl, tests).
CRON_SECRET=

# ── Server: MoonPay webhook signing ──────────────────────────────────────────
# HMAC-SHA256 secret shared with MoonPay. Used by /api/treasury/moonpay-webhook
# to verify incoming "transaction_updated" events. REQUIRED in production —
# unsigned webhooks are rejected when NODE_ENV=production.
# Dashboard: https://dashboard.moonpay.com → Developers → Webhooks
MOONPAY_WEBHOOK_SECRET=

# ── Server: Treasury buffer k-anonymity gate ─────────────────────────────────
# Minimum number of concurrently-funded routes required before any payout
# fires (prevents 1:1 buffer-in/buffer-out timing correlation). A funded
# route is held until either the cohort fills, or its individual deadline
# (registeredAt + MUGEN_TREASURY_MAX_COHORT_WAIT_MS) passes.
# Defaults: cohort=3, wait=600000 (10 min).
MUGEN_TREASURY_MIN_COHORT=3
MUGEN_TREASURY_MAX_COHORT_WAIT_MS=600000

# ── Server: FROST threshold signers (optional, external service) ─────────────
# Override defaults (http://localhost:4001/4002/4003) to point at Railway /
# external hosts when running FROST coordinator remotely.
FROST_HOST_0=
FROST_HOST_1=
FROST_HOST_2=

# ── Server: Feature flags ────────────────────────────────────────────────────
# Set to "1" to disable decoy/noise submissions. Leave unset in prod.
NOISE_ENGINE_DISABLED=
