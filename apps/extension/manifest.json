{
  "manifest_version": 3,
  "name": "Protocol 01",
  "version": "0.5.0",
  "description": "Privacy-first Solana wallet with stealth addresses and secure recurring payments",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Protocol 01",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://protocol-01.dev/*", "https://mugen-exchange.vercel.app/*", "https://*.mugen-exchange.vercel.app/*", "http://localhost:*/*"],
      "js": ["src/content/index.ts"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject.js", "polyfills.js", "circuits/*"],
      "matches": ["https://protocol-01.dev/*", "https://mugen-exchange.vercel.app/*", "https://*.mugen-exchange.vercel.app/*", "http://localhost:*/*"]
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "notifications",
    "tabs",
    "alarms",
    "offscreen"
  ],
  "host_permissions": [
    "https://*.solana.com/*",
    "https://*.helius.dev/*",
    "https://*.triton.one/*",
    "https://*.jup.ag/*",
    "https://token.jup.ag/*",
    "https://quote-api.jup.ag/*",
    "https://api.alternative.me/*",
    "https://price.jup.ag/*",
    "https://api.groq.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://mugen-exchange.vercel.app/*",
    "https://api.coingecko.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
