# Environment Configuration for Protocol 01 Extension
# Copy this file to .env and fill in the actual values

# ============================================================================
# Solana RPC Endpoints
# ============================================================================
# Primary RPC endpoint for Solana blockchain interactions
# For better performance and reliability, use a paid RPC provider like Helius
# https://www.helius.dev/ (recommended)
# https://quicknode.com/
# Or use Solana's free public RPC: https://api.mainnet-beta.solana.com
VITE_RPC_ENDPOINT=https://api.mainnet-beta.solana.com

# ============================================================================
# Helius API Key (Optional but Recommended)
# ============================================================================
# Helius RPC provider for enhanced performance and indexing
# Get a free API key from https://www.helius.dev
# When configured, the extension will use Helius endpoints instead of the free RPC
VITE_HELIUS_API_KEY=your_helius_api_key_here

# ============================================================================
# Phone pairing relay
# ============================================================================
# Host serving /api/pair/:id - where a paired phone uploads its encrypted seed
# and where this extension polls it back. Defaults to https://protocol-01.dev
# (apps/web, durable store). Set this only to point at a local web server.
# VITE_PAIR_API_BASE=http://localhost:3000
#
# Removed 2026-08-28: VITE_RELAYER_URL. It named
# https://p01-relayer-production.up.railway.app, which no read in src/ ever
# consumed and which Railway now answers with "Application not found" (404).

# ============================================================================
# Leaf indexer (2026-09-06)
# ============================================================================
# Deployed apps/web origin hosting /api/pool-leaves/:pool. Optional: falls back
# to VITE_PAIR_API_BASE, then https://protocol-01.dev. Any failure falls back
# to the RPC event scan.
VITE_P01_WEB_URL=https://protocol-01.dev
