{
  "expo": {
    "name": "Protocol 01",
    "slug": "protocol-01",
    "version": "0.9.7",
    "orientation": "portrait",
    "scheme": "p01",
    "userInterfaceStyle": "dark",
    "icon": "./assets/images/Protocol.png",
    "splash": {
      "image": "./assets/images/Protocol.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0c"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.protocol01.app",
      "backgroundColor": "#0a0a0c",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use Face ID to unlock your wallet",
        "NSBluetoothAlwaysUsageDescription": "P-01 uses Bluetooth to discover nearby users for mesh networking",
        "NSBluetoothPeripheralUsageDescription": "P-01 uses Bluetooth to connect with nearby users",
        "NFCReaderUsageDescription": "P-01 uses NFC to share shielded notes between nearby devices"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/Protocol.png",
        "backgroundColor": "#0a0a0c"
      },
      "package": "com.protocol01.app",
      "versionCode": 19,
      "permissions": [
        "USE_BIOMETRIC",
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_SCAN",
        "BLUETOOTH_CONNECT",
        "BLUETOOTH_ADVERTISE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "RECORD_AUDIO",
        "NFC"
      ]
    },
    "notification": {
      "color": "#6366f1",
      "androidMode": "default",
      "androidCollapsedTitle": "Protocol 01"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-notifications",
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "modes": [
            "peripheral",
            "central"
          ],
          "bluetoothAlwaysPermission": "P-01 uses Bluetooth to discover nearby users for mesh networking"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "P-01 needs microphone access for voice input to the AI agent."
        }
      ],
      "react-native-nfc-manager",
      [
        "llama.rn",
        {
          "enableEntitlements": true,
          "forceCxx20": true,
          "enableOpenCLAndHexagon": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "15b9f4d7-0466-4c94-a1eb-effcfe79f1ae"
      }
    }
  }
}
