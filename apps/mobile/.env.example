# Protocol 01 Mobile Environment Variables
# Copy this file to .env and fill in your values

# Helio Pay (Subscriptions & Payments)
# Dashboard: https://moonpay.dev.hel.io/developer
EXPO_PUBLIC_HELIO_API_KEY=your_helio_api_key
HELIO_SECRET_KEY=your_helio_secret_key

# MoonPay On-Ramp (Fiat to Crypto)
# Dashboard: https://dashboard.moonpay.com
# NOTE: The secret key (sk_*) is used client-side ONLY for dev/sandbox signing.
# For production, generate the HMAC signature on a backend you control and omit
# the secret from the app bundle. See services/payments/moonpay.ts.
EXPO_PUBLIC_MOONPAY_API_KEY=pk_test_xxx
EXPO_PUBLIC_MOONPAY_SECRET_KEY=sk_test_xxx
EXPO_PUBLIC_MOONPAY_MODE=sandbox

# Mugen Exchange (P-01 Network backend, P2P fiat-to-crypto)
EXPO_PUBLIC_MUGEN_API_URL=http://localhost:3001

# Privy Auth removed — local seed-phrase wallets only (spec §3 Phase 1).

# Network (devnet or mainnet-beta)
EXPO_PUBLIC_SOLANA_NETWORK=devnet

# ZK Relayer URL (for backend proof generation)
# Public tunnel URL - keeps working as long as relayer is running
EXPO_PUBLIC_RELAYER_URL=https://odd-carpets-ring.loca.lt

# ============== P-01 NETWORK FEES (Your Commission) ==============
# Swap fee in basis points: 25 = 0.25%, 50 = 0.5%, 100 = 1%
EXPO_PUBLIC_PLATFORM_FEE_BPS=25

# Buy/On-ramp fee in basis points: 50 = 0.5%
EXPO_PUBLIC_P01_NETWORK_FEE_BPS=50

# Your wallet that receives fees
# The Associated Token Accounts (ATAs) will be derived automatically for SPL tokens
# IMPORTANT: Make sure you have token accounts for USDC/USDT/etc in this wallet
EXPO_PUBLIC_FEE_WALLET=YourWalletPublicKey
