{
  "$comment": "Free inference pool: tried in order, rotated on quota. Each entry needs a free API key in agents/conway/.env under apiKeyEnv. Several entries may share one key (same provider, different model). Model ids drift; a provider answering 'model not found' is benched 24h — update the id here. Budgets (rpm/rpd) sit below the published free limits. Live-tested 2026-09-03 with a tool-calling request: every enabled entry answered with a correct tool call.",
  "cooldownMinutes": 10,
  "providers": [
    {
      "name": "groq",
      "baseUrl": "https://api.groq.com/openai",
      "model": "openai/gpt-oss-120b",
      "apiKeyEnv": "GROQ_API_KEY",
      "rpm": 25,
      "rpd": 900,
      "tokenParam": "max_completion_tokens"
    },
    {
      "name": "nvidia-nemotron-super",
      "baseUrl": "https://integrate.api.nvidia.com",
      "model": "nvidia/nemotron-3-super-120b-a12b",
