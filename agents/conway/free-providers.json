      "rpm": 30,
      "rpd": 800,
      "tokenParam": "max_tokens"
    },
    {
      "name": "mistral",
      "baseUrl": "https://api.mistral.ai",
      "model": "mistral-small-latest",
      "apiKeyEnv": "MISTRAL_API_KEY",
