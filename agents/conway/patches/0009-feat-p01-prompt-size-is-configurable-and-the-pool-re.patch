diff --git a/src/__tests__/free-pool.test.ts b/src/__tests__/free-pool.test.ts
index 41aabcb..e894dca 100644
--- a/src/__tests__/free-pool.test.ts
+++ b/src/__tests__/free-pool.test.ts
@@ -167,3 +167,31 @@ describe("free inference and survival tier", () => {
     expect(getEffectiveSurvivalTier(withPool, 0, 100)).toBe("high");
   });
 });
+
+describe("prompt size guard", () => {
+  it("skips a provider whose request-size limit the prompt exceeds", async () => {
+    let smallCalls = 0;
+    let bigCalls = 0;
+    handlers.set("/small/v1/chat/completions", (_req, res) => {
+      smallCalls++;
+      ok(res, "small");
+    });
+    handlers.set("/big/v1/chat/completions", (_req, res) => {
+      bigCalls++;
+      ok(res, "big");
+    });
+    const p = pool([
+      { name: "small", baseUrl: `${base}/small`, model: "small", apiKeyEnv: "A_KEY", maxPromptChars: 200 },
+      { name: "big", baseUrl: `${base}/big`, model: "big", apiKeyEnv: "B_KEY" },
+    ]);
+    const long = { messages: [{ role: "user", content: "x".repeat(500) }] };
+    const r1 = await p.chat(long, 10);
+    expect(r1.provider.name).toBe("big");
+    expect(smallCalls).toBe(0);
+    expect(r1.attempts[0].skipped).toMatch(/over its 200 limit/);
+    const r2 = await p.chat({ messages: [{ role: "user", content: "hi" }] }, 10);
+    expect(r2.provider.name).toBe("small");
+    expect(smallCalls).toBe(1);
+    expect(bigCalls).toBe(1);
+  });
+});
