+    const bodyChars = JSON.stringify(body).length;
     for (const p of this.providers()) {
       const s = this.state(p);
+      if (p.maxPromptChars && bodyChars > p.maxPromptChars) {
+        attempts.push({ provider: p.name, skipped: `prompt ${bodyChars} chars over its ${p.maxPromptChars} limit` });
+        continue;
+      }
       const key = this.keyFor(p);
       if (!key) {
         attempts.push({ provider: p.name, skipped: "no api key" });
