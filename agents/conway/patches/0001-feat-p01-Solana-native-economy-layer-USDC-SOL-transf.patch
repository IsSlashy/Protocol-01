+// ─── p01: on-chain USDC transfer rules ────────────────────────
+
+function usdcCentsFromArgs(args: Record<string, unknown>): number | undefined {
+  const v = args.amount_usdc;
+  if (typeof v !== "number" || !Number.isFinite(v)) return undefined;
+  return Math.round(v * 100);
+}
+
+/** Deny send_usdc above the per-transfer cap. */
+function createUsdcMaxSingleRule(policy: TreasuryPolicy): PolicyRule {
+  const max = policy.maxUsdcTransferCents ?? 50000;
+  return {
+    id: "financial.usdc_max_single",
+    description: `Deny USDC transfers above ${max} cents`,
+    priority: 500,
+    appliesTo: { by: "name", names: ["send_usdc"] },
+    evaluate(request: PolicyRequest): PolicyRuleResult | null {
+      const cents = usdcCentsFromArgs(request.args);
+      if (cents === undefined) return deny("financial.usdc_max_single", "INVALID_AMOUNT", "amount_usdc must be a finite number");
+      if (cents <= 0) return deny("financial.usdc_max_single", "INVALID_AMOUNT", "amount_usdc must be positive");
+      if (cents > max) {
+        return deny("financial.usdc_max_single", "USDC_TRANSFER_TOO_LARGE", `USDC transfer of ${cents} cents exceeds max ${max} cents`);
+      }
+      return null;
+    },
+  };
+}
+
+/** Deny send_usdc when the daily cap (tracked as category "transfer") would be exceeded. */
+function createUsdcDailyCapRule(policy: TreasuryPolicy): PolicyRule {
+  const max = policy.maxUsdcDailyCents ?? 100000;
+  return {
+    id: "financial.usdc_daily_cap",
+    description: `Deny USDC transfers when daily total would exceed ${max} cents`,
+    priority: 500,
+    appliesTo: { by: "name", names: ["send_usdc"] },
+    evaluate(request: PolicyRequest): PolicyRuleResult | null {
+      const cents = usdcCentsFromArgs(request.args);
+      if (cents === undefined) return null;
+      const daily = request.turnContext.sessionSpend.getDailySpend("transfer");
+      if (daily + cents > max) {
+        return deny("financial.usdc_daily_cap", "USDC_DAILY_CAP", `Daily USDC cap: ${daily} + ${cents} > ${max} cents`);
+      }
+      return null;
+    },
+  };
+}
+
+/** Only pay addresses the owner allowed, unless explicitly opened. */
+function createUsdcRecipientAllowlistRule(policy: TreasuryPolicy): PolicyRule {
+  return {
+    id: "financial.usdc_recipient_allowlist",
+    description: "Deny send_usdc to recipients outside the allowlist (creator, cause, usdcAllowedRecipients)",
+    priority: 500,
+    appliesTo: { by: "name", names: ["send_usdc"] },
+    evaluate(request: PolicyRequest): PolicyRuleResult | null {
+      if (policy.allowArbitraryUsdcRecipients) return null;
+      const to = String(request.args.to_address ?? "");
+      const cfg = request.context.config;
+      const allowed = new Set<string>([
+        cfg.creatorAddress,
+        cfg.economy?.causeAddress ?? "",
+        ...(policy.usdcAllowedRecipients ?? []),
+      ].filter(Boolean));
+      if (!allowed.has(to)) {
+        return deny(
+          "financial.usdc_recipient_allowlist",
+          "USDC_RECIPIENT_NOT_ALLOWED",
+          `Recipient ${to} is not in the USDC allowlist. Ask your creator to add it (treasuryPolicy.usdcAllowedRecipients) or set allowArbitraryUsdcRecipients.`,
+        );
+      }
+      return null;
+    },
+  };
+}
+
+/** Local replica requests and credit requests: at most one per turn. */
+function createRequestOncePerTurnRule(): PolicyRule {
+  return {
+    id: "financial.request_once_per_turn",
+    description: "At most one replica/credit request per turn",
+    priority: 500,
+    appliesTo: { by: "name", names: ["request_local_replica", "request_credits"] },
+    evaluate(request: PolicyRequest): PolicyRuleResult | null {
+      if (request.turnContext.turnToolCallCount >= 1) {
+        return deny("financial.request_once_per_turn", "REQUEST_RATE", "Only one request of this kind per turn");
+      }
+      return null;
+    },
+  };
+}
+
+export function createUsdcRules(treasuryPolicy: TreasuryPolicy): PolicyRule[] {
+  return [
+    createUsdcMaxSingleRule(treasuryPolicy),
+    createUsdcDailyCapRule(treasuryPolicy),
+    createUsdcRecipientAllowlistRule(treasuryPolicy),
+    createRequestOncePerTurnRule(),
+  ];
+}
