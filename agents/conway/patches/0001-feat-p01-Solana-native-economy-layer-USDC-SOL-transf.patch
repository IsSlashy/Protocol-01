+describe("sweep plan", () => {
+  it("keeps the reserve and respects threshold", () => {
+    const c = cfg();
+    const p = planSweep(c, 22, 50_000_000);
+    // reserve 20 (keepUsdcCents 2000 > usdcReserveCents 500), surplus 2 < threshold 5
+    expect(p.eligible).toBe(false);
+    const p2 = planSweep(c, 40, 50_000_000);
+    expect(p2.eligible).toBe(true);
+    expect(p2.toCreatorUsdc).toBeCloseTo(20, 6);
+    expect(p2.toCauseUsdc).toBe(0);
+  });
+  it("refuses without SOL for fees", () => {
+    expect(planSweep(cfg(), 100, 1000).eligible).toBe(false);
+  });
+  it("splits the cause share", () => {
+    const c = cfg({ economy: { ...DEFAULT_ECONOMY_CONFIG, causeAddress: "9xQeWvG816bUx9EPjHmaT23yvVM2ZWbrrpZb9PusVFin", sweep: { ...DEFAULT_ECONOMY_CONFIG.sweep, causeShareBps: 1000 } } });
