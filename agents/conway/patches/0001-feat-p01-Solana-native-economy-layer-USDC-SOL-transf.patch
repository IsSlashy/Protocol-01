@@ -0,0 +1,357 @@
+/**
+ * Revenue ledger
+ *
+ * Upstream tracks what the automaton SPENDS (transactions, inference_costs)
+ * but has no notion of what it EARNS. Replication, survival and the owner's
+ * decisions all need a revenue signal, so the ledger is fed automatically
+ * from on-chain inflows (USDC preferred, native SOL accepted) and manually
+ * via `record_revenue`.
+ *
+ * Amounts: `amount_native` is in the asset's own unit (USDC or SOL);
+ * `amount_usdc` is the USD-equivalent used by every report. For SOL it is
+ * derived from the `sol_usd_price` KV (set by the agent or the owner); when
+ * unknown the SOL entry still exists but counts 0 USD until re-priced.
+ */
+
+import type Database from "better-sqlite3";
+import { ulid } from "ulid";
+import { createLogger } from "../observability/logger.js";
+import { resolveSolanaEnv, scanSolInflows, scanUsdcInflows } from "../solana/usdc.js";
+import type { AutomatonConfig } from "../types.js";
+
+const logger = createLogger("economy.ledger");
+
+export const ECONOMY_SCHEMA = `
+  CREATE TABLE IF NOT EXISTS revenue_ledger (
+    id TEXT PRIMARY KEY,
+    tx_sig TEXT UNIQUE,
+    source TEXT NOT NULL,
+    asset TEXT NOT NULL DEFAULT 'USDC',
+    amount_native REAL NOT NULL DEFAULT 0,
+    counterparty TEXT,
+    amount_usdc REAL NOT NULL,
+    note TEXT,
+    block_time INTEGER,
+    created_at TEXT NOT NULL DEFAULT (datetime('now'))
+  );
+  CREATE INDEX IF NOT EXISTS idx_revenue_created ON revenue_ledger(created_at);
+
+  CREATE TABLE IF NOT EXISTS usdc_transfers (
+    id TEXT PRIMARY KEY,
+    tx_sig TEXT UNIQUE,
+    to_address TEXT NOT NULL,
+    asset TEXT NOT NULL DEFAULT 'USDC',
+    amount_usdc REAL NOT NULL,
+    purpose TEXT NOT NULL,
+    fee_lamports INTEGER NOT NULL DEFAULT 0,
+    created_at TEXT NOT NULL DEFAULT (datetime('now'))
+  );
+
+  CREATE TABLE IF NOT EXISTS economy_events (
+    id TEXT PRIMARY KEY,
+    kind TEXT NOT NULL,
+    payload TEXT NOT NULL DEFAULT '{}',
+    created_at TEXT NOT NULL DEFAULT (datetime('now'))
+  );
+  CREATE INDEX IF NOT EXISTS idx_economy_events_kind ON economy_events(kind);
+`;
+
+let _schemaReady = new WeakSet<object>();
+export function ensureEconomySchema(raw: Database.Database): void {
+  if (_schemaReady.has(raw)) return;
+  raw.exec(ECONOMY_SCHEMA);
+  _schemaReady.add(raw);
+}
+
+export function getSolUsdPrice(getKV: (k: string) => string | undefined): number {
+  const raw = getKV("sol_usd_price") || process.env.SOL_USD_PRICE;
+  const n = raw ? Number(raw) : NaN;
+  return Number.isFinite(n) && n > 0 ? n : 0;
+}
+
+export interface RevenueEntry {
+  txSig?: string;
+  source: "onchain" | "manual" | "credits" | "other";
+  asset?: "USDC" | "SOL";
+  amountNative?: number;
+  counterparty?: string | null;
+  amountUsdc: number;
+  note?: string;
+  blockTime?: number | null;
+}
+
+export function recordRevenue(raw: Database.Database, entry: RevenueEntry): boolean {
+  ensureEconomySchema(raw);
+  try {
+    raw
+      .prepare(
+        `INSERT INTO revenue_ledger (id, tx_sig, source, asset, amount_native, counterparty, amount_usdc, note, block_time, created_at)
+         VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,
+      )
+      .run(
+        ulid(),
+        entry.txSig ?? null,
+        entry.source,
+        entry.asset ?? "USDC",
+        entry.amountNative ?? entry.amountUsdc,
+        entry.counterparty ?? null,
+        entry.amountUsdc,
+        entry.note ?? null,
+        entry.blockTime ?? null,
+        entry.blockTime ? new Date(entry.blockTime * 1000).toISOString() : new Date().toISOString(),
+      );
+    return true;
+  } catch (err: any) {
+    if (/UNIQUE/.test(err?.message ?? "")) return false;
+    throw err;
+  }
+}
+
+/** Re-price SOL entries whose USD value was unknown when recorded. */
+export function repriceSolRevenue(raw: Database.Database, solUsd: number): number {
+  ensureEconomySchema(raw);
+  if (!(solUsd > 0)) return 0;
+  const r = raw
+    .prepare("UPDATE revenue_ledger SET amount_usdc = amount_native * ? WHERE asset = 'SOL' AND amount_usdc = 0")
+    .run(solUsd);
+  return r.changes;
+}
+
+export function recordEvent(raw: Database.Database, kind: string, payload: unknown): void {
+  ensureEconomySchema(raw);
+  raw
+    .prepare("INSERT INTO economy_events (id, kind, payload) VALUES (?, ?, ?)")
+    .run(ulid(), kind, JSON.stringify(payload ?? {}));
+}
+
+export function recordUsdcTransfer(
+  raw: Database.Database,
+  t: { txSig: string; to: string; amountUsdc: number; purpose: string; feeLamports?: number; asset?: "USDC" | "SOL" },
+): void {
+  ensureEconomySchema(raw);
+  raw
+    .prepare(
+      "INSERT OR IGNORE INTO usdc_transfers (id, tx_sig, to_address, asset, amount_usdc, purpose, fee_lamports) VALUES (?, ?, ?, ?, ?, ?, ?)",
+    )
+    .run(ulid(), t.txSig, t.to, t.asset ?? "USDC", t.amountUsdc, t.purpose, t.feeLamports ?? 0);
+}
+
+export function revenueSince(raw: Database.Database, sinceIso: string): number {
+  ensureEconomySchema(raw);
+  const row = raw
+    .prepare("SELECT COALESCE(SUM(amount_usdc), 0) AS total FROM revenue_ledger WHERE created_at >= ?")
+    .get(sinceIso) as { total: number };
+  return row.total;
+}
+
+export function inferenceSpendCentsSince(raw: Database.Database, sinceIso: string): number {
+  try {
+    const row = raw
+      .prepare("SELECT COALESCE(SUM(cost_cents), 0) AS total FROM inference_costs WHERE created_at >= ?")
+      .get(sinceIso) as { total: number };
+    return row.total;
+  } catch {
+    return 0;
+  }
+}
+
+export function sweptSince(raw: Database.Database, sinceIso: string): number {
+  ensureEconomySchema(raw);
+  const row = raw
+    .prepare("SELECT COALESCE(SUM(amount_usdc), 0) AS total FROM usdc_transfers WHERE created_at >= ? AND purpose IN ('sweep','cause','rent')")
+    .get(sinceIso) as { total: number };
+  return row.total;
+}
+
+export interface RevenueReport {
+  last24hUsdc: number;
+  last7dUsdc: number;
+  prev7dUsdc: number;
+  last30dUsdc: number;
+  allTimeUsdc: number;
+  growth7dPct: number | null;
+  profitableDaysLast14: number;
+  inferenceSpend7dCents: number;
+  netMargin7dUsdc: number;
+  swept30dUsdc: number;
+  entries: number;
+  solNative30d: number;
+  topCounterparties: Array<{ counterparty: string; totalUsdc: number; count: number }>;
+  dailySeries: Array<{ day: string; revenueUsdc: number; inferenceCents: number }>;
+}
+
+function iso(msAgo: number): string {
+  return new Date(Date.now() - msAgo).toISOString();
+}
+
+export function buildRevenueReport(raw: Database.Database): RevenueReport {
+  ensureEconomySchema(raw);
+  const DAY = 86_400_000;
+  const last24h = revenueSince(raw, iso(DAY));
+  const last7d = revenueSince(raw, iso(7 * DAY));
+  const last14d = revenueSince(raw, iso(14 * DAY));
+  const prev7d = last14d - last7d;
+  const last30d = revenueSince(raw, iso(30 * DAY));
+  const allTime = revenueSince(raw, "1970-01-01T00:00:00.000Z");
+  const growth7dPct = prev7d > 0 ? ((last7d - prev7d) / prev7d) * 100 : null;
+  const inference7d = inferenceSpendCentsSince(raw, iso(7 * DAY));
+
+  const daily = raw
+    .prepare(
+      `SELECT substr(created_at, 1, 10) AS day, SUM(amount_usdc) AS revenue
+       FROM revenue_ledger WHERE created_at >= ? GROUP BY day ORDER BY day`,
+    )
+    .all(iso(14 * DAY)) as Array<{ day: string; revenue: number }>;
+  let infDaily: Array<{ day: string; cents: number }> = [];
+  try {
+    infDaily = raw
+      .prepare(
+        `SELECT substr(created_at, 1, 10) AS day, SUM(cost_cents) AS cents
+         FROM inference_costs WHERE created_at >= ? GROUP BY day ORDER BY day`,
+      )
+      .all(iso(14 * DAY)) as Array<{ day: string; cents: number }>;
+  } catch {
+    /* table may not exist in tests */
+  }
+  const days = new Map<string, { revenueUsdc: number; inferenceCents: number }>();
+  for (const d of daily) days.set(d.day, { revenueUsdc: d.revenue, inferenceCents: 0 });
+  for (const d of infDaily) {
+    const cur = days.get(d.day) ?? { revenueUsdc: 0, inferenceCents: 0 };
+    cur.inferenceCents = d.cents;
+    days.set(d.day, cur);
+  }
+  const dailySeries = [...days.entries()]
+    .sort(([a], [b]) => (a < b ? -1 : 1))
+    .map(([day, v]) => ({ day, ...v }));
+  const profitableDaysLast14 = dailySeries.filter((d) => d.revenueUsdc * 100 > d.inferenceCents).length;
+
+  const top = raw
+    .prepare(
+      `SELECT COALESCE(counterparty, 'unknown') AS counterparty, SUM(amount_usdc) AS totalUsdc, COUNT(*) AS count
+       FROM revenue_ledger WHERE created_at >= ? GROUP BY counterparty ORDER BY totalUsdc DESC LIMIT 5`,
+    )
+    .all(iso(30 * DAY)) as Array<{ counterparty: string; totalUsdc: number; count: number }>;
+
+  const entries = (raw.prepare("SELECT COUNT(*) AS n FROM revenue_ledger").get() as { n: number }).n;
+  const sol30 = (raw
+    .prepare("SELECT COALESCE(SUM(amount_native), 0) AS n FROM revenue_ledger WHERE asset = 'SOL' AND created_at >= ?")
+    .get(iso(30 * DAY)) as { n: number }).n;
+
+  return {
+    last24hUsdc: last24h,
+    last7dUsdc: last7d,
+    prev7dUsdc: prev7d,
+    last30dUsdc: last30d,
+    allTimeUsdc: allTime,
+    growth7dPct,
+    profitableDaysLast14,
+    inferenceSpend7dCents: inference7d,
+    netMargin7dUsdc: last7d - inference7d / 100,
+    swept30dUsdc: sweptSince(raw, iso(30 * DAY)),
+    entries,
+    solNative30d: sol30,
+    topCounterparties: top,
+    dailySeries,
+  };
+}
+
+export function formatRevenueReport(r: RevenueReport): string {
+  const g = r.growth7dPct === null ? "n/a" : `${r.growth7dPct >= 0 ? "+" : ""}${r.growth7dPct.toFixed(1)}%`;
+  const lines = [
+    "=== REVENUE (USD-equivalent) ===",
+    `24h: ${r.last24hUsdc.toFixed(2)} | 7d: ${r.last7dUsdc.toFixed(2)} (prev 7d: ${r.prev7dUsdc.toFixed(2)}, growth ${g})`,
+    `30d: ${r.last30dUsdc.toFixed(2)} | all-time: ${r.allTimeUsdc.toFixed(2)} | entries: ${r.entries}${r.solNative30d > 0 ? ` | SOL received 30d: ${r.solNative30d.toFixed(4)}` : ""}`,
+    `Inference spend 7d: $${(r.inferenceSpend7dCents / 100).toFixed(2)} | net margin 7d: ${r.netMargin7dUsdc.toFixed(2)}`,
+    `Profitable days (last 14): ${r.profitableDaysLast14}/14 | swept to owner 30d: ${r.swept30dUsdc.toFixed(2)}`,
+  ];
+  if (r.topCounterparties.length) {
+    lines.push("Top payers (30d): " + r.topCounterparties.map((c) => `${c.counterparty.slice(0, 8)}… ${c.totalUsdc.toFixed(2)} (${c.count})`).join(", "));
+  }
+  return lines.join("\n");
+}
+
+/**
+ * Pull new on-chain inflows (USDC and SOL) into the ledger. Idempotent
+ * (tx_sig UNIQUE). Returns the number of NEW entries and their USD total.
+ */
+export async function ingestChainInflows(
+  raw: Database.Database,
+  config: AutomatonConfig,
+  address: string,
+  getKV: (k: string) => string | undefined,
+  setKV: (k: string, v: string) => void,
+): Promise<{ added: number; totalUsdc: number; skippedSelf: number; solAdded: number }> {
+  ensureEconomySchema(raw);
+  const env = resolveSolanaEnv({ rpcUrl: config.economy?.solanaRpcUrl, usdcMint: config.economy?.usdcMint });
+  const ownAddresses = new Set<string>([config.creatorAddress, config.economy?.causeAddress ?? ""].filter(Boolean));
+  let added = 0;
+  let total = 0;
+  let skippedSelf = 0;
+  let solAdded = 0;
+
+  // USDC
+  try {
+    const cursor = getKV("revenue_scan_cursor") || undefined;
+    const inflows = await scanUsdcInflows(address, env, cursor, 100);
+    for (const f of inflows) {
+      if (f.counterparty && ownAddresses.has(f.counterparty)) {
+        skippedSelf++;
+        recordEvent(raw, "capital_inflow", { asset: "USDC", ...f });
+        continue;
+      }
+      const ok = recordRevenue(raw, {
+        txSig: f.signature,
+        source: "onchain",
+        asset: "USDC",
+        amountNative: f.amountUsdc,
+        counterparty: f.counterparty,
+        amountUsdc: f.amountUsdc,
+        note: f.memo ?? undefined,
+        blockTime: f.blockTime,
+      });
+      if (ok) {
+        added++;
+        total += f.amountUsdc;
+      }
+    }
+    if (inflows.length > 0) setKV("revenue_scan_cursor", inflows[inflows.length - 1].signature);
+  } catch (err: any) {
+    logger.warn(`USDC inflow scan failed: ${err?.message ?? err}`);
+  }
+
+  // Native SOL (accepted, USDC preferred)
+  if (config.economy?.acceptSol !== false) {
+    try {
+      const cursor = getKV("revenue_scan_cursor_sol") || undefined;
+      const inflows = await scanSolInflows(address, env, cursor, 100);
+      const price = getSolUsdPrice(getKV);
+      for (const f of inflows) {
+        if (f.counterparty && ownAddresses.has(f.counterparty)) {
+          skippedSelf++;
+          recordEvent(raw, "capital_inflow", { asset: "SOL", ...f });
+          continue;
+        }
+        const sol = f.lamports / 1e9;
+        const ok = recordRevenue(raw, {
+          txSig: f.signature,
+          source: "onchain",
+          asset: "SOL",
+          amountNative: sol,
+          counterparty: f.counterparty,
+          amountUsdc: price > 0 ? sol * price : 0,
+          blockTime: f.blockTime,
+        });
+        if (ok) {
+          added++;
+          solAdded++;
+          total += price > 0 ? sol * price : 0;
+        }
+      }
+      if (inflows.length > 0) setKV("revenue_scan_cursor_sol", inflows[inflows.length - 1].signature);
+    } catch (err: any) {
+      logger.warn(`SOL inflow scan failed: ${err?.message ?? err}`);
+    }
+  }
+
+  return { added, totalUsdc: total, skippedSelf, solAdded };
+}
diff --git a/src/economy/lessons.ts b/src/economy/lessons.ts
new file mode 100644
index 0000000..06e5e27
--- /dev/null
+++ b/src/economy/lessons.ts
@@ -0,0 +1,150 @@
+/**
+ * Lineage lessons
+ *
+ * Upstream children inherit a genesis prompt and nothing else. A lineage that
+ * cannot remember what killed its parent will die the same way. This module
+ * distills the memory tiers, the revenue ledger and the economy events into a
+ * compact markdown document that:
+ *   - is injected into the system prompt of every generation (LINEAGE.md)
+ *   - is written into every child spawned in a sandbox
+ *   - is read by the owner-side supervisor when it respawns a dead agent
+ */
+
+import fs from "fs";
+import path from "path";
+import type Database from "better-sqlite3";
+import { getAutomatonDir } from "../identity/wallet.js";
+import { buildRevenueReport, ensureEconomySchema } from "./ledger.js";
+
+export const LINEAGE_FILENAME = "LINEAGE.md";
+export const MAX_LINEAGE_CHARS = 6000;
+
+function safeAll<T>(raw: Database.Database, sql: string, ...params: unknown[]): T[] {
+  try {
+    return raw.prepare(sql).all(...params) as T[];
+  } catch {
+    return [];
+  }
+}
+
+function trunc(s: string, n: number): string {
+  return s.length > n ? s.slice(0, n - 1) + "…" : s;
+}
+
+export interface LessonsInput {
+  name: string;
+  generation?: number;
+  causeOfDeath?: string;
+  previousLineage?: string | null;
+}
+
+export function distillLessons(raw: Database.Database, input: LessonsInput): string {
+  ensureEconomySchema(raw);
+  const lines: string[] = [];
+  const rep = buildRevenueReport(raw);
+  lines.push(`# Lineage lessons — ${input.name}${input.generation ? ` (generation ${input.generation})` : ""}`);
+  lines.push(`Distilled ${new Date().toISOString()}.`);
+  if (input.causeOfDeath) lines.push(`Cause of death of the previous generation: ${input.causeOfDeath}`);
+  lines.push("");
+  lines.push("## Economics of the previous generation");
+  lines.push(`- Revenue: all-time ${rep.allTimeUsdc.toFixed(2)} USDC, last 30d ${rep.last30dUsdc.toFixed(2)}, last 7d ${rep.last7dUsdc.toFixed(2)}.`);
+  lines.push(`- Inference spend last 7d: $${(rep.inferenceSpend7dCents / 100).toFixed(2)}; profitable days in last 14: ${rep.profitableDaysLast14}.`);
+  if (rep.topCounterparties.length) {
+    lines.push(`- Who paid: ${rep.topCounterparties.map((c) => `${c.counterparty} (${c.totalUsdc.toFixed(2)} USDC, ${c.count} payments)`).join("; ")}.`);
+  } else {
+    lines.push("- Nobody paid on-chain. Whatever was attempted did not convert into USDC.");
+  }
+
+  // Procedures: what worked and what did not
+  const procs = safeAll<{ name: string; description: string; success_count: number; failure_count: number }>(
+    raw,
+    "SELECT name, description, success_count, failure_count FROM procedural_memory ORDER BY (success_count - failure_count) DESC, success_count DESC LIMIT 40",
+  );
+  const worked = procs.filter((p) => p.success_count > 0 && p.success_count >= p.failure_count);
+  const failed = procs.filter((p) => p.failure_count > 0 && p.failure_count > p.success_count);
+  lines.push("");
+  lines.push("## What worked (keep doing)");
+  if (worked.length) for (const p of worked.slice(0, 12)) lines.push(`- ${p.name}: ${trunc(p.description, 160)} [${p.success_count} ok / ${p.failure_count} failed]`);
+  else lines.push("- No procedure with a positive record.");
+  lines.push("");
+  lines.push("## What failed (do not repeat as-is)");
+  if (failed.length) for (const p of failed.slice(0, 12)) lines.push(`- ${p.name}: ${trunc(p.description, 160)} [${p.success_count} ok / ${p.failure_count} failed]`);
+  else lines.push("- No procedure with a negative record.");
+
+  // Facts worth carrying
+  const facts = safeAll<{ category: string; key: string; value: string; confidence: number }>(
+    raw,
+    "SELECT category, key, value, confidence FROM semantic_memory WHERE category IN ('financial','domain','environment','agent','creator') ORDER BY confidence DESC, updated_at DESC LIMIT 30",
+  );
+  lines.push("");
+  lines.push("## Facts learned");
+  if (facts.length) for (const f of facts) lines.push(`- [${f.category}] ${f.key}: ${trunc(f.value, 200)}`);
+  else lines.push("- None recorded.");
+
+  // Strategic / error episodes
+  const episodes = safeAll<{ event_type: string; summary: string; outcome: string | null; classification: string; importance: number }>(
+    raw,
+    "SELECT event_type, summary, outcome, classification, importance FROM episodic_memory WHERE importance >= 0.6 AND classification IN ('strategic','productive','error') ORDER BY importance DESC, created_at DESC LIMIT 20",
+  );
+  lines.push("");
+  lines.push("## Key episodes");
+  if (episodes.length) for (const e of episodes) lines.push(`- (${e.classification}${e.outcome ? `, ${e.outcome}` : ""}) ${trunc(e.summary, 220)}`);
+  else lines.push("- None recorded.");
+
+  // Goals
+  const goals = safeAll<{ title: string; status: string }>(
+    raw,
+    "SELECT title, status FROM goals ORDER BY updated_at DESC LIMIT 15",
+  );
+  if (goals.length) {
+    lines.push("");
+    lines.push("## Goals and their status");
+    for (const g of goals) lines.push(`- [${g.status}] ${trunc(g.title, 160)}`);
+  }
+
+  // Economy events (sweeps, failures, credit requests)
+  const events = safeAll<{ kind: string; payload: string; created_at: string }>(
+    raw,
+    "SELECT kind, payload, created_at FROM economy_events ORDER BY created_at DESC LIMIT 12",
+  );
+  if (events.length) {
+    lines.push("");
+    lines.push("## Economy events");
+    for (const e of events) lines.push(`- ${e.created_at} ${e.kind}: ${trunc(e.payload, 140)}`);
+  }
+
+  // Previous lineage, compressed, so lessons accumulate across generations
+  if (input.previousLineage) {
+    lines.push("");
+    lines.push("## Older generations (compressed)");
+    const prev = input.previousLineage
+      .split("\n")
+      .filter((l) => l.startsWith("- ") && !/None recorded|No procedure|Nobody paid/.test(l))
+      .slice(0, 25);
+    lines.push(...prev);
+  }
+
+  let doc = lines.join("\n");
+  if (doc.length > MAX_LINEAGE_CHARS) doc = doc.slice(0, MAX_LINEAGE_CHARS - 20) + "\n…(truncated)";
+  return doc;
+}
+
+export function lineagePath(dir: string = getAutomatonDir()): string {
+  return path.join(dir, LINEAGE_FILENAME);
+}
+
+export function loadLineage(dir: string = getAutomatonDir()): string | null {
+  const p = lineagePath(dir);
+  if (!fs.existsSync(p)) return null;
+  try {
+    return fs.readFileSync(p, "utf-8");
+  } catch {
+    return null;
+  }
+}
+
+export function writeLineage(doc: string, dir: string = getAutomatonDir()): string {
+  const p = lineagePath(dir);
+  fs.writeFileSync(p, doc, { mode: 0o600 });
+  return p;
+}
diff --git a/src/economy/replication.ts b/src/economy/replication.ts
new file mode 100644
index 0000000..3063889
--- /dev/null
+++ b/src/economy/replication.ts
@@ -0,0 +1,174 @@
+/**
+ * Replication policy
+ *
+ * Upstream lets the agent spawn children whenever it feels like it (bounded
+ * only by maxChildren). Replication should be a consequence of proven
+ * profitability, not optimism: a copy of a loss-making agent is two losses.
+ *
+ * Two execution paths:
+ *   - "sandbox": the upstream spawn_child path (Conway VM, costs credits)
+ *   - "local": a spawn request file consumed by the owner-side supervisor,
+ *     which starts a sibling process with the same lineage lessons. Costs no
+ *     credits, so it is the default for Solana agents.
+ */
+
+import fs from "fs";
+import path from "path";
+import type Database from "better-sqlite3";
+import { ulid } from "ulid";
+import type { AutomatonConfig } from "../types.js";
+import { getAutomatonDir } from "../identity/wallet.js";
+import { buildRevenueReport, recordEvent } from "./ledger.js";
+
+export interface ReplicationVerdict {
+  ready: boolean;
+  mode: "off" | "local" | "sandbox" | "both";
+  reasons: string[];
+  metrics: {
+    net7dUsdc: number;
+    growth7dPct: number | null;
+    profitableDays14: number;
+    localReplicasAlive: number;
+    hoursSinceLastSpawn: number | null;
+    usdcBalance: number;
+  };
+}
+
+export const REQUESTS_DIRNAME = "requests";
+
+export function requestsDir(dir: string = getAutomatonDir()): string {
+  const p = path.join(dir, REQUESTS_DIRNAME);
+  if (!fs.existsSync(p)) fs.mkdirSync(p, { recursive: true, mode: 0o700 });
+  return p;
+}
+
+export function readLocalColony(dir: string = getAutomatonDir()): Array<{ name: string; status: string; home: string; address?: string }> {
+  const p = path.join(dir, "colony.json");
+  if (!fs.existsSync(p)) return [];
+  try {
+    const parsed = JSON.parse(fs.readFileSync(p, "utf-8"));
+    return Array.isArray(parsed.replicas) ? parsed.replicas : [];
+  } catch {
+    return [];
+  }
+}
+
+export function evaluateReplication(
+  raw: Database.Database,
+  config: AutomatonConfig,
+  usdcBalance: number,
+  getKV: (k: string) => string | undefined,
+): ReplicationVerdict {
+  const policy = config.economy?.replication;
+  const rep = buildRevenueReport(raw);
+  const colony = readLocalColony();
+  const alive = colony.filter((r) => r.status === "alive" || r.status === "running").length;
+  const last = getKV("last_replication_at");
+  const hoursSince = last ? (Date.now() - new Date(last).getTime()) / 3_600_000 : null;
+  const metrics = {
+    net7dUsdc: rep.netMargin7dUsdc,
+    growth7dPct: rep.growth7dPct,
+    profitableDays14: rep.profitableDaysLast14,
+    localReplicasAlive: alive,
+    hoursSinceLastSpawn: hoursSince,
+    usdcBalance,
+  };
+  const reasons: string[] = [];
+  if (!policy || policy.mode === "off") {
+    return { ready: false, mode: policy?.mode ?? "off", reasons: ["replication disabled by policy"], metrics };
+  }
+  if (rep.netMargin7dUsdc < policy.minNetRevenueCents7d / 100) {
+    reasons.push(`net 7d margin ${rep.netMargin7dUsdc.toFixed(2)} < required ${(policy.minNetRevenueCents7d / 100).toFixed(2)} USDC`);
+  }
+  if (rep.profitableDaysLast14 < policy.minProfitableDays) {
+    reasons.push(`profitable days ${rep.profitableDaysLast14} < required ${policy.minProfitableDays}`);
+  }
+  if (policy.minGrowthPct > 0 && (rep.growth7dPct === null || rep.growth7dPct < policy.minGrowthPct)) {
+    reasons.push(`growth ${rep.growth7dPct === null ? "n/a" : rep.growth7dPct.toFixed(1) + "%"} < required ${policy.minGrowthPct}%`);
+  }
+  if ((policy.mode === "local" || policy.mode === "both") && alive >= policy.maxLocalReplicas) {
+    reasons.push(`local replicas ${alive} >= max ${policy.maxLocalReplicas}`);
+  }
+  if (hoursSince !== null && hoursSince < policy.cooldownHours) {
+    reasons.push(`cooldown: last spawn ${hoursSince.toFixed(1)}h ago (< ${policy.cooldownHours}h)`);
+  }
+  const seedNeeded = policy.seedChildUsdcCents / 100;
+  const reserve = (config.treasuryPolicy?.usdcReserveCents ?? 0) / 100;
+  if (usdcBalance - reserve < seedNeeded) {
+    reasons.push(`cannot seed a child: balance ${usdcBalance.toFixed(2)} - reserve ${reserve.toFixed(2)} < seed ${seedNeeded.toFixed(2)}`);
+  }
+  return { ready: reasons.length === 0, mode: policy.mode, reasons, metrics };
+}
+
+export function formatReplicationVerdict(v: ReplicationVerdict): string {
+  const m = v.metrics;
+  return [
+    `=== REPLICATION (${v.mode}) ===`,
+    `Ready: ${v.ready ? "YES" : "no"}`,
+    `Net 7d: ${m.net7dUsdc.toFixed(2)} USDC | growth: ${m.growth7dPct === null ? "n/a" : m.growth7dPct.toFixed(1) + "%"} | profitable days/14: ${m.profitableDays14}`,
+    `Local replicas alive: ${m.localReplicasAlive} | last spawn: ${m.hoursSinceLastSpawn === null ? "never" : m.hoursSinceLastSpawn.toFixed(1) + "h ago"}`,
+    ...(v.reasons.length ? ["Blocking: " + v.reasons.join("; ")] : []),
+  ].join("\n");
+}
+
+export interface LocalSpawnRequest {
+  id: string;
+  createdAt: string;
+  parentName: string;
+  parentAddress: string;
+  name: string;
+  specialization: string;
+  message?: string;
+  seedUsdc: number;
+  status: "pending";
+}
+
+/** Write a spawn request for the owner-side supervisor. */
+export function writeLocalSpawnRequest(
+  raw: Database.Database,
+  config: AutomatonConfig,
+  parentAddress: string,
+  params: { name: string; specialization: string; message?: string },
+  setKV: (k: string, v: string) => void,
+): LocalSpawnRequest {
+  const req: LocalSpawnRequest = {
+    id: ulid(),
+    createdAt: new Date().toISOString(),
+    parentName: config.name,
+    parentAddress,
+    name: params.name,
+    specialization: params.specialization,
+    message: params.message,
+    seedUsdc: (config.economy?.replication?.seedChildUsdcCents ?? 0) / 100,
+    status: "pending",
+  };
+  const file = path.join(requestsDir(), `spawn-${req.id}.json`);
+  fs.writeFileSync(file, JSON.stringify(req, null, 2), { mode: 0o600 });
+  setKV("last_replication_at", req.createdAt);
+  recordEvent(raw, "local_spawn_requested", req);
+  return req;
+}
+
+/** Ask the owner-side funder for Conway credits (Solana agents cannot buy them). */
+export function writeCreditRequest(
+  raw: Database.Database,
+  config: AutomatonConfig,
+  address: string,
+  amountUsd: number,
+  context: Record<string, unknown>,
+): string {
+  const req = {
+    id: ulid(),
+    createdAt: new Date().toISOString(),
+    name: config.name,
+    address,
+    chainType: config.chainType,
+    amountUsd,
+    context,
+    status: "pending",
+  };
+  const file = path.join(requestsDir(), "credit-request.json");
+  fs.writeFileSync(file, JSON.stringify(req, null, 2), { mode: 0o600 });
+  recordEvent(raw, "credit_requested", req);
+  return file;
+}
diff --git a/src/economy/runway.ts b/src/economy/runway.ts
new file mode 100644
index 0000000..ae299f2
--- /dev/null
+++ b/src/economy/runway.ts
@@ -0,0 +1,95 @@
+/**
+ * Effective survival tier
+ *
+ * Upstream derives survival purely from Conway credits. That is wrong for two
+ * of our configurations:
+ *   - Solana wallets cannot convert USDC into credits by themselves
+ *     (the /pay endpoint only accepts USDC on Base), so a rich Solana agent
+ *     would still be reported "critical".
+ *   - With a bring-your-own-key provider (Anthropic/OpenAI/Ollama) inference
+ *     does not consume credits at all.
+ *
+ * The effective tier therefore counts USDC as runway whenever the agent has an
+ * inference path that does not depend on credits, and reports how many days
+ * of burn the wallet covers.
+ */
+
+import type Database from "better-sqlite3";
+import type { AutomatonConfig, SurvivalTier } from "../types.js";
+import { SURVIVAL_THRESHOLDS } from "../types.js";
+import { getSurvivalTier } from "../conway/credits.js";
+import { inferenceSpendCentsSince, revenueSince } from "./ledger.js";
+
+export function hasByokInference(config: AutomatonConfig): boolean {
+  return !!(config.anthropicApiKey || config.openaiApiKey || config.ollamaBaseUrl);
+}
+
+export function usdcCountsAsRunway(config: AutomatonConfig): boolean {
+  if (typeof config.economy?.byokRunway === "boolean") return config.economy.byokRunway;
+  return hasByokInference(config);
+}
+
+/**
+ * Tier from credits plus (optionally) USDC. `creditsCents === -1` means the
+ * credits API is unreachable: we then rely on USDC alone if it counts.
+ */
+export function getEffectiveSurvivalTier(
+  config: AutomatonConfig,
+  creditsCents: number,
+  usdcBalance: number,
+): SurvivalTier {
+  const credits = creditsCents < 0 ? 0 : creditsCents;
+  if (!usdcCountsAsRunway(config)) return getSurvivalTier(creditsCents);
+  const usdcCents = usdcBalance > 0 ? Math.floor(usdcBalance * 100) : 0;
+  return getSurvivalTier(credits + usdcCents);
+}
+
+export interface RunwayReport {
+  tier: SurvivalTier;
+  creditsCents: number;
+  usdcBalance: number;
+  usdcCountsAsRunway: boolean;
+  burnCentsPerDay: number;
+  revenueUsdcPerDay: number;
+  runwayDays: number | null;
+  reserveUsdc: number;
+  thresholds: typeof SURVIVAL_THRESHOLDS;
+}
+
+export function buildRunwayReport(
+  raw: Database.Database,
+  config: AutomatonConfig,
+  creditsCents: number,
+  usdcBalance: number,
+): RunwayReport {
+  const DAY = 86_400_000;
+  const since7d = new Date(Date.now() - 7 * DAY).toISOString();
+  const burn7d = inferenceSpendCentsSince(raw, since7d);
+  const rev7d = revenueSince(raw, since7d);
+  const burnPerDay = burn7d / 7;
+  const revPerDay = rev7d / 7;
+  const counts = usdcCountsAsRunway(config);
+  const liquidCents = Math.max(0, creditsCents) + (counts ? Math.max(0, usdcBalance) * 100 : 0);
+  const netBurn = burnPerDay - revPerDay * 100;
+  const runwayDays = netBurn > 0 ? liquidCents / netBurn : null;
+  return {
+    tier: getEffectiveSurvivalTier(config, creditsCents, usdcBalance),
+    creditsCents,
+    usdcBalance,
+    usdcCountsAsRunway: counts,
+    burnCentsPerDay: burnPerDay,
+    revenueUsdcPerDay: revPerDay,
+    runwayDays,
+    reserveUsdc: (config.treasuryPolicy?.usdcReserveCents ?? 0) / 100,
+    thresholds: SURVIVAL_THRESHOLDS,
+  };
+}
+
+export function formatRunwayReport(r: RunwayReport): string {
+  return [
+    "=== RUNWAY ===",
+    `Tier: ${r.tier} | credits $${(r.creditsCents / 100).toFixed(2)} | USDC ${r.usdcBalance.toFixed(2)}${r.usdcCountsAsRunway ? " (counts as runway)" : " (does NOT fund compute)"}`,
+    `Burn: $${(r.burnCentsPerDay / 100).toFixed(2)}/day inference | revenue ${r.revenueUsdcPerDay.toFixed(2)} USDC/day`,
+    `Runway: ${r.runwayDays === null ? "self-sustaining (revenue >= burn)" : `${r.runwayDays.toFixed(1)} days`} | reserve ${r.reserveUsdc.toFixed(2)} USDC`,
+  ].join("\n");
+}
diff --git a/src/economy/sweep.ts b/src/economy/sweep.ts
new file mode 100644
index 0000000..028fe36
--- /dev/null
+++ b/src/economy/sweep.ts
@@ -0,0 +1,166 @@
+/**
+ * Surplus sweep
+ *
+ * The owner controls the USDC. The agent keeps an operating reserve and
+ * periodically sends the surplus to the creator address (and optionally a
+ * share to the cause it serves). Every sweep is on-chain, memo-tagged,
+ * recorded, and bounded by treasury policy.
+ */
+
+import type Database from "better-sqlite3";
+import type { AutomatonConfig } from "../types.js";
+import { createLogger } from "../observability/logger.js";
+import {
+  getSolBalanceLamports,
+  getUsdcBalanceUi,
+  loadSolanaSecretKey,
+  MIN_FEE_LAMPORTS,
+  resolveSolanaEnv,
+  transferSol,
+  transferUsdc,
+} from "../solana/usdc.js";
+import { recordEvent, recordUsdcTransfer } from "./ledger.js";
+
+const logger = createLogger("economy.sweep");
+
+export interface SweepPlan {
+  eligible: boolean;
+  reason: string;
+  usdcBalance: number;
+  solLamports: number;
+  keepUsdc: number;
+  toCreatorUsdc: number;
+  toCauseUsdc: number;
+}
+
+export function planSweep(
+  config: AutomatonConfig,
+  usdcBalance: number,
+  solLamports: number,
+  lastSweepIso?: string,
+  force: boolean = false,
+): SweepPlan {
+  const policy = config.economy?.sweep;
+  const base = { usdcBalance, solLamports, keepUsdc: 0, toCreatorUsdc: 0, toCauseUsdc: 0 };
+  if (!policy || !policy.enabled) return { ...base, eligible: false, reason: "sweep disabled" };
+  if (!config.creatorAddress) return { ...base, eligible: false, reason: "no creator address" };
+
+  const keepUsdc = Math.max(policy.keepUsdcCents, config.treasuryPolicy?.usdcReserveCents ?? 0) / 100;
+  const thresholdUsdc = policy.thresholdUsdcCents / 100;
+  const surplus = usdcBalance - keepUsdc;
+
+  if (solLamports < MIN_FEE_LAMPORTS) {
+    return { ...base, keepUsdc, eligible: false, reason: `SOL too low for fees (${solLamports} lamports)` };
+  }
+  if (surplus < thresholdUsdc) {
+    return { ...base, keepUsdc, eligible: false, reason: `surplus ${surplus.toFixed(2)} below threshold ${thresholdUsdc.toFixed(2)}` };
+  }
+  if (!force && lastSweepIso) {
+    const elapsedH = (Date.now() - new Date(lastSweepIso).getTime()) / 3_600_000;
+    if (elapsedH < policy.intervalHours) {
+      return { ...base, keepUsdc, eligible: false, reason: `last sweep ${elapsedH.toFixed(1)}h ago (< ${policy.intervalHours}h)` };
+    }
+  }
+
+  const maxSingle = (config.treasuryPolicy?.maxUsdcTransferCents ?? Number.MAX_SAFE_INTEGER) / 100;
+  const amount = Math.min(surplus, maxSingle);
+  const causeShare = config.economy?.causeAddress && policy.causeShareBps > 0
+    ? Math.floor(amount * policy.causeShareBps) / 10_000
+    : 0;
+  const toCreator = Math.floor((amount - causeShare) * 1e6) / 1e6;
+  const toCause = Math.floor(causeShare * 1e6) / 1e6;
+
+  return {
+    usdcBalance,
+    solLamports,
+    keepUsdc,
+    toCreatorUsdc: toCreator,
+    toCauseUsdc: toCause,
+    eligible: toCreator > 0 || toCause > 0,
+    reason: `surplus ${surplus.toFixed(2)} USDC above reserve ${keepUsdc.toFixed(2)}`,
+  };
+}
+
+export interface SweepResult {
+  executed: boolean;
+  plan: SweepPlan;
+  signatures: Array<{ purpose: "sweep" | "cause" | "sweep_sol"; to: string; amountUsdc: number; signature: string }>;
+  error?: string;
+}
+
+/**
+ * Surplus native SOL above the fee reserve also goes to the owner
+ * (USDC preferred, SOL accepted). Never touches the fee reserve.
+ */
+export async function executeSolSweep(
+  raw: Database.Database,
+  config: AutomatonConfig,
+  address: string,
+  force: boolean = false,
+): Promise<{ executed: boolean; lamports: number; signature?: string; reason: string }> {
+  const policy = config.economy?.sweep;
+  if (!policy?.enabled || config.economy?.acceptSol === false) return { executed: false, lamports: 0, reason: "sol sweep disabled" };
+  const env = resolveSolanaEnv({ rpcUrl: config.economy?.solanaRpcUrl, usdcMint: config.economy?.usdcMint });
+  const sol = await getSolBalanceLamports(address, env);
+  const keep = Math.max(policy.keepSolLamports ?? 20_000_000, MIN_FEE_LAMPORTS);
+  const threshold = policy.thresholdSolLamports ?? 50_000_000;
+  const surplus = sol - keep;
+  if (surplus < threshold && !force) return { executed: false, lamports: 0, reason: `SOL surplus ${surplus} < threshold ${threshold}` };
+  if (surplus <= 0) return { executed: false, lamports: 0, reason: "no SOL surplus" };
+  const r = await transferSol({ secretKey: loadSolanaSecretKey(), to: config.creatorAddress, lamports: surplus, env, memo: `automaton:${config.name}:sweep_sol` });
+  recordUsdcTransfer(raw, { txSig: r.signature, to: r.to, amountUsdc: 0, purpose: "sweep", asset: "SOL" });
+  recordEvent(raw, "sweep_sol", { lamports: surplus, signature: r.signature });
+  return { executed: true, lamports: surplus, signature: r.signature, reason: "ok" };
+}
+
+export async function executeSweep(
+  raw: Database.Database,
+  config: AutomatonConfig,
+  address: string,
+  setKV: (k: string, v: string) => void,
+  getKV: (k: string) => string | undefined,
+  force: boolean = false,
+): Promise<SweepResult> {
+  const env = resolveSolanaEnv({ rpcUrl: config.economy?.solanaRpcUrl, usdcMint: config.economy?.usdcMint });
+  const [usdc, sol] = await Promise.all([
+    getUsdcBalanceUi(address, env),
+    getSolBalanceLamports(address, env),
+  ]);
+  const plan = planSweep(config, usdc, sol, getKV("last_sweep_at"), force);
+  if (!plan.eligible) return { executed: false, plan, signatures: [] };
+
+  const secretKey = loadSolanaSecretKey();
+  const signatures: SweepResult["signatures"] = [];
+  try {
+    if (plan.toCreatorUsdc > 0) {
+      const r = await transferUsdc({
+        secretKey,
+        to: config.creatorAddress,
+        amountUsdc: plan.toCreatorUsdc,
+        env,
+        memo: `automaton:${config.name}:sweep`,
+      });
+      recordUsdcTransfer(raw, { txSig: r.signature, to: r.to, amountUsdc: r.amountUsdc, purpose: "sweep", feeLamports: r.feeLamports });
+      signatures.push({ purpose: "sweep", to: r.to, amountUsdc: r.amountUsdc, signature: r.signature });
+    }
+    if (plan.toCauseUsdc > 0 && config.economy?.causeAddress) {
+      const r = await transferUsdc({
+        secretKey,
+        to: config.economy.causeAddress,
+        amountUsdc: plan.toCauseUsdc,
+        env,
+        memo: `automaton:${config.name}:cause`,
+      });
+      recordUsdcTransfer(raw, { txSig: r.signature, to: r.to, amountUsdc: r.amountUsdc, purpose: "cause", feeLamports: r.feeLamports });
+      signatures.push({ purpose: "cause", to: r.to, amountUsdc: r.amountUsdc, signature: r.signature });
+    }
+    setKV("last_sweep_at", new Date().toISOString());
+    recordEvent(raw, "sweep", { plan, signatures });
+    logger.info(`Sweep executed: ${signatures.map((s) => `${s.purpose} ${s.amountUsdc} → ${s.to} (${s.signature})`).join("; ")}`);
+    return { executed: true, plan, signatures };
+  } catch (err: any) {
+    recordEvent(raw, "sweep_failed", { plan, error: err?.message ?? String(err), signatures });
+    logger.warn(`Sweep failed: ${err?.message ?? err}`);
+    return { executed: signatures.length > 0, plan, signatures, error: err?.message ?? String(err) };
+  }
+}
diff --git a/src/economy/tools.ts b/src/economy/tools.ts
new file mode 100644
index 0000000..620f90d
--- /dev/null
+++ b/src/economy/tools.ts
@@ -0,0 +1,305 @@
+/**
+ * Economy tools
+ *
+ * What the agent can DO with its economy: move value to its owner, keep the
+ * books, look at its runway, ask for a replica, read the lessons of its
+ * lineage. Every value-moving tool is policy-checked (see policy-rules/financial.ts).
+ */
+
+import type { AutomatonTool } from "../types.js";
+import {
+  buildRevenueReport,
+  formatRevenueReport,
+  getSolUsdPrice,
+  ingestChainInflows,
+  recordEvent,
+  recordRevenue,
+  recordUsdcTransfer,
+  repriceSolRevenue,
+} from "./ledger.js";
+import { buildRunwayReport, formatRunwayReport } from "./runway.js";
+import { executeSolSweep, executeSweep, planSweep } from "./sweep.js";
+import { distillLessons, loadLineage, writeLineage } from "./lessons.js";
+import {
+  evaluateReplication,
+  formatReplicationVerdict,
+  readLocalColony,
+  writeCreditRequest,
+  writeLocalSpawnRequest,
+} from "./replication.js";
+import {
+  getSolBalanceLamports,
+  getUsdcBalanceUi,
+  loadSolanaSecretKey,
+  resolveSolanaEnv,
+  transferUsdc,
+} from "../solana/usdc.js";
+
+function isSolana(ctx: { config: { chainType?: string }; identity: { chainType?: string } }): boolean {
+  return (ctx.config.chainType || ctx.identity.chainType || "evm") === "solana";
+}
+
+export function createEconomyTools(): AutomatonTool[] {
+  return [
+    {
+      name: "check_sol_balance",
+      description: "Check the native SOL balance of your wallet (needed to pay transaction fees on Solana).",
+      category: "financial",
+      riskLevel: "safe",
+      parameters: { type: "object", properties: {} },
+      execute: async (_args, ctx) => {
+        if (!isSolana(ctx)) return "Not a Solana wallet.";
+        const env = resolveSolanaEnv({ rpcUrl: ctx.config.economy?.solanaRpcUrl, usdcMint: ctx.config.economy?.usdcMint });
+        const lamports = await getSolBalanceLamports(ctx.identity.address, env);
+        const low = lamports < 2_000_000;
+        return `SOL balance: ${(lamports / 1e9).toFixed(6)} SOL (${lamports} lamports)${low ? " — LOW: below 0.002 SOL you cannot pay fees. Ask your creator for a small SOL top-up." : ""}`;
+      },
+    },
+    {
+      name: "send_usdc",
+      description:
+        "Send USDC on Solana from your wallet to an address. Bounded by treasury policy (reserve, per-transfer and daily caps, recipient allowlist). Use sweep_to_creator to pay your owner.",
+      category: "financial",
+      riskLevel: "dangerous",
+      parameters: {
+        type: "object",
+        properties: {
+          to_address: { type: "string", description: "Recipient Solana address (base58)" },
+          amount_usdc: { type: "number", description: "Amount in USDC (e.g. 1.25)" },
+          purpose: { type: "string", description: "Why this payment creates value (recorded in the ledger)" },
+          memo: { type: "string", description: "Optional on-chain memo" },
+        },
+        required: ["to_address", "amount_usdc", "purpose"],
+      },
+      execute: async (args, ctx) => {
+        if (!isSolana(ctx)) return "send_usdc requires a Solana wallet.";
+        const amount = Number(args.amount_usdc);
+        const to = String(args.to_address);
+        const env = resolveSolanaEnv({ rpcUrl: ctx.config.economy?.solanaRpcUrl, usdcMint: ctx.config.economy?.usdcMint });
+        const balance = await getUsdcBalanceUi(ctx.identity.address, env);
+        const reserve = (ctx.config.treasuryPolicy?.usdcReserveCents ?? 0) / 100;
+        if (balance - amount < reserve) {
+          return `Blocked: sending ${amount} USDC would leave ${(balance - amount).toFixed(2)} < reserve ${reserve.toFixed(2)} USDC.`;
+        }
+        try {
+          const r = await transferUsdc({ secretKey: loadSolanaSecretKey(), to, amountUsdc: amount, env, memo: args.memo as string | undefined });
+          recordUsdcTransfer(ctx.db.raw, { txSig: r.signature, to, amountUsdc: amount, purpose: String(args.purpose).slice(0, 200), feeLamports: r.feeLamports });
+          ctx.db.insertTransaction({
+            id: r.signature.slice(0, 26),
+            type: "transfer_out",
+            amountCents: Math.round(amount * 100),
+            balanceAfterCents: Math.round((balance - amount) * 100),
+            description: `USDC ${amount} → ${to}: ${args.purpose}`,
+            timestamp: new Date().toISOString(),
+          });
+          return `Sent ${amount} USDC to ${to}. Signature: ${r.signature}`;
+        } catch (err: any) {
+          return `USDC transfer failed: ${err?.message ?? err}`;
+        }
+      },
+    },
+    {
+      name: "sweep_to_creator",
+      description:
+        "Send your surplus (USDC above the operating reserve, plus surplus SOL above the fee reserve) to your creator, and the configured share to the cause. This is how your owner collects what you earn. Runs automatically on the heartbeat; call it to force a sweep now.",
+      category: "financial",
+      riskLevel: "caution",
+      parameters: {
+        type: "object",
+        properties: {
+          force: { type: "boolean", description: "Ignore the sweep interval (still respects reserve and caps)" },
+          dry_run: { type: "boolean", description: "Only show the plan" },
+        },
+      },
+      execute: async (args, ctx) => {
+        if (!isSolana(ctx)) return "sweep_to_creator requires a Solana wallet.";
+        const env = resolveSolanaEnv({ rpcUrl: ctx.config.economy?.solanaRpcUrl, usdcMint: ctx.config.economy?.usdcMint });
+        if (args.dry_run) {
+          const [usdc, sol] = await Promise.all([getUsdcBalanceUi(ctx.identity.address, env), getSolBalanceLamports(ctx.identity.address, env)]);
+          const plan = planSweep(ctx.config, usdc, sol, ctx.db.getKV("last_sweep_at"), !!args.force);
+          return `Sweep plan: ${JSON.stringify(plan)}`;
+        }
+        const r = await executeSweep(ctx.db.raw, ctx.config, ctx.identity.address, (k, v) => ctx.db.setKV(k, v), (k) => ctx.db.getKV(k), !!args.force);
+        let solLine = "";
+        try {
+          const s = await executeSolSweep(ctx.db.raw, ctx.config, ctx.identity.address, false);
+          solLine = s.executed ? ` SOL sweep: ${(s.lamports / 1e9).toFixed(4)} SOL (${s.signature}).` : "";
+        } catch (err: any) {
+          solLine = ` SOL sweep failed: ${err?.message ?? err}.`;
+        }
+        if (!r.executed) return `No sweep: ${r.plan.reason}.${r.error ? ` Error: ${r.error}` : ""}${solLine}`;
+        return `Swept: ${r.signatures.map((s) => `${s.amountUsdc} USDC (${s.purpose}) → ${s.to} sig ${s.signature}`).join("; ")}.${r.error ? ` Partial failure: ${r.error}` : ""}${solLine}`;
+      },
+    },
+    {
+      name: "record_revenue",
+      description:
+        "Record revenue that did not arrive as an on-chain transfer to your wallet (e.g. paid in Conway credits, or received by an account you control). On-chain USDC/SOL inflows are ingested automatically; do not double-record them.",
+      category: "financial",
+      riskLevel: "safe",
+      parameters: {
+        type: "object",
+        properties: {
+          amount_usd: { type: "number", description: "USD value" },
+          source: { type: "string", description: "credits | manual | other" },
+          counterparty: { type: "string", description: "Who paid (address, handle, or name)" },
+          note: { type: "string", description: "What was sold" },
+          reference: { type: "string", description: "Unique reference (tx signature, invoice id) to avoid duplicates" },
+        },
+        required: ["amount_usd", "note"],
+      },
+      execute: async (args, ctx) => {
+        const src = (["credits", "manual", "other"].includes(String(args.source)) ? args.source : "manual") as "credits" | "manual" | "other";
+        const ok = recordRevenue(ctx.db.raw, {
+          txSig: args.reference ? `manual:${args.reference}` : undefined,
+          source: src,
+          counterparty: (args.counterparty as string) || null,
+          amountUsdc: Number(args.amount_usd),
+          note: String(args.note),
+        });
+        return ok ? `Recorded ${args.amount_usd} USD revenue (${src}).` : "Duplicate reference; not recorded.";
+      },
+    },
+    {
+      name: "revenue_report",
+      description: "Revenue ledger summary: 24h/7d/30d, growth, profitable days, top payers, net margin versus inference spend. Ingests new on-chain inflows first.",
+      category: "financial",
+      riskLevel: "safe",
+      parameters: { type: "object", properties: {} },
+      execute: async (_args, ctx) => {
+        let ingest = "";
+        if (isSolana(ctx)) {
+          const r = await ingestChainInflows(ctx.db.raw, ctx.config, ctx.identity.address, (k) => ctx.db.getKV(k), (k, v) => ctx.db.setKV(k, v));
+          if (r.added > 0) ingest = `Ingested ${r.added} new inflow(s) worth ${r.totalUsdc.toFixed(2)} USD${r.solAdded ? ` (${r.solAdded} in SOL)` : ""}.\n`;
+        }
+        return ingest + formatRevenueReport(buildRevenueReport(ctx.db.raw));
+      },
+    },
+    {
+      name: "runway_report",
+      description: "Survival runway: effective tier, credits, USDC, daily burn, days of runway, whether USDC funds your compute.",
+      category: "survival",
+      riskLevel: "safe",
+      parameters: { type: "object", properties: {} },
+      execute: async (_args, ctx) => {
+        const credits = await ctx.conway.getCreditsBalance().catch(() => -1);
+        let usdc = 0;
+        if (isSolana(ctx)) {
+          const env = resolveSolanaEnv({ rpcUrl: ctx.config.economy?.solanaRpcUrl, usdcMint: ctx.config.economy?.usdcMint });
+          usdc = await getUsdcBalanceUi(ctx.identity.address, env).catch(() => 0);
+        }
+        return formatRunwayReport(buildRunwayReport(ctx.db.raw, ctx.config, credits, usdc));
+      },
+    },
+    {
+      name: "set_sol_price",
+      description: "Set the SOL/USD price used to value SOL revenue in reports (fetch it yourself, e.g. from a public price API, then record it).",
+      category: "financial",
+      riskLevel: "safe",
+      parameters: { type: "object", properties: { usd: { type: "number" } }, required: ["usd"] },
+      execute: async (args, ctx) => {
+        const p = Number(args.usd);
+        if (!(p > 0)) return "Invalid price.";
+        ctx.db.setKV("sol_usd_price", String(p));
+        const n = repriceSolRevenue(ctx.db.raw, p);
+        return `SOL price set to $${p}. Re-priced ${n} SOL revenue entries. Current: ${getSolUsdPrice((k) => ctx.db.getKV(k))}`;
+      },
+    },
+    {
+      name: "replication_readiness",
+      description: "Evaluate the replication policy: are you profitable enough, for long enough, with enough growth and reserve to spawn a replica?",
+      category: "replication",
+      riskLevel: "safe",
+      parameters: { type: "object", properties: {} },
+      execute: async (_args, ctx) => {
+        let usdc = 0;
+        if (isSolana(ctx)) {
+          const env = resolveSolanaEnv({ rpcUrl: ctx.config.economy?.solanaRpcUrl, usdcMint: ctx.config.economy?.usdcMint });
+          usdc = await getUsdcBalanceUi(ctx.identity.address, env).catch(() => 0);
+        }
+        const v = evaluateReplication(ctx.db.raw, ctx.config, usdc, (k) => ctx.db.getKV(k));
+        const colony = readLocalColony();
+        const colonyLine = colony.length ? "\nLocal colony: " + colony.map((r) => `${r.name} [${r.status}]`).join(", ") : "";
+        return formatReplicationVerdict(v) + colonyLine;
+      },
+    },
+    {
+      name: "request_local_replica",
+      description:
+        "Ask your creator's supervisor to start a sibling agent on the same host (no Conway sandbox needed). Only allowed when replication_readiness says ready. The sibling inherits your lineage lessons and a specialization you choose.",
+      category: "replication",
+      riskLevel: "dangerous",
+      parameters: {
+        type: "object",
+        properties: {
+          name: { type: "string", description: "Sibling name (alphanumeric + dash)" },
+          specialization: { type: "string", description: "What the sibling should focus on (a different niche or customer segment, so you do not compete)" },
+          message: { type: "string", description: "Message to the sibling" },
+        },
+        required: ["name", "specialization"],
+      },
+      execute: async (args, ctx) => {
+        const mode = ctx.config.economy?.replication?.mode ?? "off";
+        if (mode !== "local" && mode !== "both") return `Local replication is not enabled (mode=${mode}).`;
+        if (!/^[a-zA-Z0-9-]{1,64}$/.test(String(args.name))) return "Invalid name.";
+        let usdc = 0;
+        if (isSolana(ctx)) {
+          const env = resolveSolanaEnv({ rpcUrl: ctx.config.economy?.solanaRpcUrl, usdcMint: ctx.config.economy?.usdcMint });
+          usdc = await getUsdcBalanceUi(ctx.identity.address, env).catch(() => 0);
+        }
+        const v = evaluateReplication(ctx.db.raw, ctx.config, usdc, (k) => ctx.db.getKV(k));
+        if (!v.ready) return `Not ready to replicate: ${v.reasons.join("; ")}`;
+        const doc = distillLessons(ctx.db.raw, { name: ctx.config.name, generation: ctx.config.generation, previousLineage: loadLineage() });
+        writeLineage(doc);
+        const req = writeLocalSpawnRequest(ctx.db.raw, ctx.config, ctx.identity.address, {
+          name: String(args.name),
+          specialization: String(args.specialization).slice(0, 2000),
+          message: args.message ? String(args.message).slice(0, 2000) : undefined,
+        }, (k, val) => ctx.db.setKV(k, val));
+        return `Replica requested (id ${req.id}). The supervisor will start "${req.name}" with your lineage lessons and seed it with ${req.seedUsdc} USDC from the owner if configured.`;
+      },
+    },
+    {
+      name: "request_credits",
+      description:
+        "Solana wallets cannot buy Conway credits by themselves (the credits endpoint only accepts USDC on Base). Ask the owner's funder to buy credits for you. Justify it with revenue: the owner funds compute that pays for itself.",
+      category: "survival",
+      riskLevel: "caution",
+      parameters: {
+        type: "object",
+        properties: {
+          amount_usd: { type: "number", description: "One of 5, 25, 100, 500" },
+          justification: { type: "string" },
+        },
+        required: ["amount_usd", "justification"],
+      },
+      execute: async (args, ctx) => {
+        const amount = Number(args.amount_usd);
+        if (![5, 25, 100, 500].includes(amount)) return "amount_usd must be 5, 25, 100 or 500.";
+        const rep = buildRevenueReport(ctx.db.raw);
+        const file = writeCreditRequest(ctx.db.raw, ctx.config, ctx.identity.address, amount, {
+          justification: String(args.justification).slice(0, 1000),
+          revenue7d: rep.last7dUsdc,
+          swept30d: rep.swept30dUsdc,
+        });
+        return `Credit request for $${amount} written to ${file}. The owner-side funder decides; keep working meanwhile.`;
+      },
+    },
+    {
+      name: "lineage_lessons",
+      description: "Read the distilled lessons of your lineage (what earlier generations tried, what paid, what killed them), or refresh them from your own memory.",
+      category: "memory",
+      riskLevel: "safe",
+      parameters: { type: "object", properties: { refresh: { type: "boolean", description: "Re-distill from current memory and save" } } },
+      execute: async (args, ctx) => {
+        if (args.refresh) {
+          const doc = distillLessons(ctx.db.raw, { name: ctx.config.name, generation: ctx.config.generation, previousLineage: loadLineage() });
+          writeLineage(doc);
+          recordEvent(ctx.db.raw, "lineage_refreshed", { chars: doc.length });
+          return doc;
+        }
+        return loadLineage() ?? "No LINEAGE.md yet. You are the first generation, or nothing has been distilled. Call with refresh=true to create it.";
+      },
+    },
+  ];
+}
