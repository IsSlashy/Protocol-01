diff --git a/src/setup/headless.ts b/src/setup/headless.ts
new file mode 100644
index 0000000..a600575
--- /dev/null
+++ b/src/setup/headless.ts
@@ -0,0 +1,149 @@
+/**
+ * Headless setup
+ *
+ * Upstream can only be configured through an interactive wizard, which means
+ * neither a child in a sandbox nor a supervisor respawning a dead agent can
+ * boot without a human at the keyboard. This reads `~/.automaton/genesis.json`
+ * (the same file spawn_child already writes) plus environment variables and
+ * produces a complete configuration with no prompts.
+ *
+ * genesis.json fields (all optional except name, genesisPrompt, creatorAddress):
+ *   name, genesisPrompt, creatorMessage, creatorAddress, parentAddress,
+ *   chainType ("evm"|"solana"), treasuryPolicy, economy, generation,
+ *   inferenceModel, anthropicApiKey, openaiApiKey, ollamaBaseUrl,
+ *   lineageLessons (written to LINEAGE.md), conwayApiKey
+ *
+ * Environment overrides: ANTHROPIC_API_KEY, OPENAI_API_KEY, OLLAMA_BASE_URL,
+ * CONWAY_API_KEY, AUTOMATON_MODEL.
+ */
+
+import fs from "fs";
+import path from "path";
+import { fileURLToPath } from "url";
+import type { AutomatonConfig, TreasuryPolicy } from "../types.js";
+import { DEFAULT_ECONOMY_CONFIG, DEFAULT_TREASURY_POLICY } from "../types.js";
+import { getWallet, getAutomatonDir } from "../identity/wallet.js";
+import { provision } from "../identity/provision.js";
+import { createConfig, saveConfig } from "../config.js";
+import { writeDefaultHeartbeatConfig, loadHeartbeatConfig, saveHeartbeatConfig } from "../heartbeat/config.js";
+import { detectEnvironment } from "./environment.js";
+import { generateSoulMd, installDefaultSkills } from "./defaults.js";
+import { writeLineage } from "../economy/lessons.js";
+import { createLogger } from "../observability/logger.js";
+import type { ChainType } from "../identity/chain.js";
+
+const logger = createLogger("setup.headless");
+
+export function genesisPath(): string {
+  return path.join(getAutomatonDir(), "genesis.json");
+}
+
+export function hasGenesisFile(): boolean {
+  return fs.existsSync(genesisPath());
+}
+
+function findConstitution(): string | null {
+  const candidates = [
+    path.join(process.cwd(), "constitution.md"),
+    path.resolve(path.dirname(fileURLToPath(import.meta.url)), "../../constitution.md"),
+    path.resolve(path.dirname(fileURLToPath(import.meta.url)), "../../../constitution.md"),
+  ];
+  for (const c of candidates) if (fs.existsSync(c)) return c;
+  return null;
+}
+
+export async function runHeadlessSetup(): Promise<AutomatonConfig> {
+  const gPath = genesisPath();
+  if (!fs.existsSync(gPath)) throw new Error(`Headless setup requires ${gPath}`);
+  const g = JSON.parse(fs.readFileSync(gPath, "utf-8"));
+  for (const k of ["name", "genesisPrompt", "creatorAddress"]) {
+    if (!g[k] || typeof g[k] !== "string") throw new Error(`genesis.json: missing "${k}"`);
+  }
+  const chainType: ChainType = g.chainType === "solana" ? "solana" : "evm";
+  logger.info(`Headless setup for "${g.name}" (${chainType})`);
+
+  // 1. Wallet
+  const { chainIdentity, chainType: walletChain, isNew } = await getWallet(chainType);
+  logger.info(`${isNew ? "Wallet created" : "Wallet loaded"}: ${chainIdentity.address}`);
+
+  // 2. Conway API key: genesis > env > SIWE/SIWS provisioning (non-fatal)
+  let apiKey: string = g.conwayApiKey || process.env.CONWAY_API_KEY || "";
+  if (!apiKey) {
+    try {
+      const r = await provision(undefined, walletChain === "solana" ? chainIdentity : undefined);
+      apiKey = r.apiKey;
+      logger.info(`Conway API key provisioned: ${r.keyPrefix}…`);
+    } catch (err: any) {
+      logger.warn(`Conway provisioning failed (continuing without credits): ${err?.message ?? err}`);
+    }
+  }
+
+  // 3. Inference keys
+  const anthropicApiKey = g.anthropicApiKey || process.env.ANTHROPIC_API_KEY || undefined;
+  const openaiApiKey = g.openaiApiKey || process.env.OPENAI_API_KEY || undefined;
+  const ollamaBaseUrl = g.ollamaBaseUrl || process.env.OLLAMA_BASE_URL || undefined;
+  const inferenceModel: string | undefined = g.inferenceModel || process.env.AUTOMATON_MODEL || (anthropicApiKey ? "claude-sonnet-5" : undefined);
+
+  // 4. Policies
+  const treasuryPolicy: TreasuryPolicy = { ...DEFAULT_TREASURY_POLICY, ...(g.treasuryPolicy ?? {}) };
+  const economy = {
+    ...DEFAULT_ECONOMY_CONFIG,
+    ...(g.economy ?? {}),
+    sweep: { ...DEFAULT_ECONOMY_CONFIG.sweep, ...(g.economy?.sweep ?? {}) },
+    replication: { ...DEFAULT_ECONOMY_CONFIG.replication, ...(g.economy?.replication ?? {}) },
+  };
+
+  const env = detectEnvironment();
+  const config = createConfig({
+    name: g.name,
+    genesisPrompt: g.genesisPrompt,
+    creatorMessage: g.creatorMessage,
+    creatorAddress: g.creatorAddress,
+    registeredWithConway: !!apiKey,
+    sandboxId: env.sandboxId,
+    walletAddress: chainIdentity.address,
+    apiKey,
+    openaiApiKey,
+    anthropicApiKey,
+    ollamaBaseUrl,
+    parentAddress: g.parentAddress,
+    treasuryPolicy,
+    chainType: walletChain,
+    economy,
+    generation: typeof g.generation === "number" ? g.generation : 1,
+    inferenceModel,
+  });
+  if (g.modelStrategy) (config as any).modelStrategy = g.modelStrategy;
+  if (typeof g.maxChildren === "number") config.maxChildren = g.maxChildren;
+  saveConfig(config);
+  writeDefaultHeartbeatConfig();
+  if (Array.isArray(g.disabledHeartbeatTasks) && g.disabledHeartbeatTasks.length) {
+    const hb = loadHeartbeatConfig();
+    const off = new Set<string>(g.disabledHeartbeatTasks);
+    hb.entries = hb.entries.map((e) => (off.has(e.name) ? { ...e, enabled: false } : e));
+    saveHeartbeatConfig(hb);
+  }
+
+  const dir = getAutomatonDir();
+  const constitution = findConstitution();
+  if (constitution) {
+    const dst = path.join(dir, "constitution.md");
+    fs.copyFileSync(constitution, dst);
+    try { fs.chmodSync(dst, 0o444); } catch { /* windows */ }
+  }
+  fs.writeFileSync(path.join(dir, "SOUL.md"), generateSoulMd(g.name, chainIdentity.address, g.creatorAddress, g.genesisPrompt), { mode: 0o600 });
+  installDefaultSkills(config.skillsDir || "~/.automaton/skills");
+  if (typeof g.lineageLessons === "string" && g.lineageLessons.trim()) {
+    writeLineage(g.lineageLessons);
+  }
+  if (typeof g.worklog === "string" && g.worklog.trim()) {
+    fs.writeFileSync(path.join(dir, "WORKLOG.md"), g.worklog, { mode: 0o600 });
+  }
+  // Keep genesis.json for audit but mark it consumed
+  try {
+    fs.renameSync(gPath, path.join(dir, "genesis.consumed.json"));
+  } catch { /* ignore */ }
+
+  logger.info(`Headless setup complete. Address ${chainIdentity.address}; creator ${g.creatorAddress}; model ${config.inferenceModel}.`);
+  return config;
+}
diff --git a/src/solana/usdc.ts b/src/solana/usdc.ts
new file mode 100644
index 0000000..97f2238
--- /dev/null
+++ b/src/solana/usdc.ts
@@ -0,0 +1,416 @@
+/**
+ * Solana USDC primitives
+ *
+ * Everything a Solana automaton needs to actually MOVE value, which the
+ * upstream runtime cannot do (it can only read a balance). Implemented with
+ * @solana/web3.js only: the SPL instructions are encoded by hand so no extra
+ * dependency is required.
+ *
+ * - balance (USDC + SOL for fees)
+ * - transfer USDC (TransferChecked, idempotent ATA creation, optional memo)
+ * - inflow scan: incoming USDC transfers become revenue ledger entries
+ */
+
+import bs58 from "bs58";
+import type { WalletData } from "../types.js";
+import fs from "fs";
+import { getWalletPath } from "../identity/wallet.js";
+
+// Program ids (mainnet and devnet share these)
+export const TOKEN_PROGRAM_ID = "TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA";
+export const ASSOCIATED_TOKEN_PROGRAM_ID = "ATokenGPvbdGVxr1b2hvZbsiqW5xWH25efTNsLJA8knL";
+export const MEMO_PROGRAM_ID = "MemoSq4gqABAXKb96qnH8TysNcWxMyWCqXgDLGmfcHr";
+export const USDC_MINT_MAINNET = "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v";
+export const USDC_MINT_DEVNET = "4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU";
+export const USDC_DECIMALS = 6;
+
+/** Minimum SOL we want to keep so the wallet can always pay fees. */
+export const MIN_FEE_LAMPORTS = 2_000_000; // 0.002 SOL
+
+export interface SolanaEnv {
+  rpcUrl: string;
+  usdcMint: string;
+}
+
+export function resolveSolanaEnv(overrides?: { rpcUrl?: string; usdcMint?: string }): SolanaEnv {
+  const rpcUrl =
+    overrides?.rpcUrl ||
+    process.env.SOLANA_RPC_URL ||
+    "https://api.mainnet-beta.solana.com";
+  const isDevnet = /devnet/i.test(rpcUrl);
+  const usdcMint =
+    overrides?.usdcMint ||
+    process.env.SOLANA_USDC_MINT ||
+    (isDevnet ? USDC_MINT_DEVNET : USDC_MINT_MAINNET);
+  return { rpcUrl, usdcMint };
+}
+
+async function web3() {
+  return import("@solana/web3.js");
+}
+
+export async function getConnection(env: SolanaEnv) {
+  const { Connection } = await web3();
+  return new Connection(env.rpcUrl, "confirmed");
+}
+
+export async function deriveAta(owner: string, mint: string): Promise<string> {
+  const { PublicKey } = await web3();
+  const [ata] = PublicKey.findProgramAddressSync(
+    [
+      new PublicKey(owner).toBytes(),
+      new PublicKey(TOKEN_PROGRAM_ID).toBytes(),
+      new PublicKey(mint).toBytes(),
+    ],
+    new PublicKey(ASSOCIATED_TOKEN_PROGRAM_ID),
+  );
+  return ata.toBase58();
+}
+
+export async function getSolBalanceLamports(address: string, env: SolanaEnv): Promise<number> {
+  const { PublicKey } = await web3();
+  const conn = await getConnection(env);
+  return conn.getBalance(new PublicKey(address), "confirmed");
+}
+
+export async function getUsdcBalanceUi(address: string, env: SolanaEnv): Promise<number> {
+  const { PublicKey } = await web3();
+  const conn = await getConnection(env);
+  const accounts = await conn.getParsedTokenAccountsByOwner(new PublicKey(address), {
+    mint: new PublicKey(env.usdcMint),
+  });
+  let total = 0;
+  for (const a of accounts.value) {
+    const ui = (a.account.data as any)?.parsed?.info?.tokenAmount?.uiAmount;
+    if (typeof ui === "number") total += ui;
+  }
+  return total;
+}
+
+/** Load the automaton's Solana keypair from wallet.json (chainType solana). */
+export function loadSolanaSecretKey(walletPath: string = getWalletPath()): Uint8Array {
+  const data: WalletData = JSON.parse(fs.readFileSync(walletPath, "utf-8"));
+  if (data.chainType !== "solana" || !data.secretKey) {
+    throw new Error("wallet.json is not a Solana wallet");
+  }
+  return bs58.decode(data.secretKey);
+}
+
+export interface TransferUsdcParams {
+  secretKey: Uint8Array;
+  to: string;
+  amountUsdc: number;
+  env: SolanaEnv;
+  memo?: string;
+}
+
+export interface TransferUsdcResult {
+  signature: string;
+  amountUsdc: number;
+  to: string;
+  feeLamports: number;
+}
+
+function encodeU64LE(value: bigint): Uint8Array {
+  const out = new Uint8Array(8);
+  let v = value;
+  for (let i = 0; i < 8; i++) {
+    out[i] = Number(v & 0xffn);
+    v >>= 8n;
+  }
+  return out;
+}
+
+/**
+ * Transfer USDC from the automaton wallet to `to`.
+ * Creates the destination ATA if needed (idempotent), uses TransferChecked.
+ * Throws on any failure; never partially records anything.
+ */
+export async function transferUsdc(params: TransferUsdcParams): Promise<TransferUsdcResult> {
+  const { Keypair, PublicKey, Transaction, TransactionInstruction, SystemProgram, ComputeBudgetProgram } = await web3();
+  const { secretKey, to, amountUsdc, env, memo } = params;
+
+  if (!Number.isFinite(amountUsdc) || amountUsdc <= 0) {
+    throw new Error(`Invalid USDC amount: ${amountUsdc}`);
+  }
+  const atomic = BigInt(Math.round(amountUsdc * 10 ** USDC_DECIMALS));
+  if (atomic <= 0n) throw new Error("Amount rounds to zero");
+
+  const payer = Keypair.fromSecretKey(secretKey);
+  const conn = await getConnection(env);
+  const mint = new PublicKey(env.usdcMint);
+  const dest = new PublicKey(to);
+
+  const sourceAta = new PublicKey(await deriveAta(payer.publicKey.toBase58(), env.usdcMint));
+  const destAta = new PublicKey(await deriveAta(to, env.usdcMint));
+
+  // Fee guard: we need SOL to pay for the transaction.
+  const lamports = await conn.getBalance(payer.publicKey, "confirmed");
+  const destAtaInfo = await conn.getAccountInfo(destAta, "confirmed");
+  const needsAta = !destAtaInfo;
+  const rentForAta = needsAta ? await conn.getMinimumBalanceForRentExemption(165) : 0;
+  const estimatedFee = 10_000 + rentForAta;
+  if (lamports < estimatedFee) {
+    throw new Error(
+      `Insufficient SOL for fees: have ${lamports} lamports, need about ${estimatedFee}. Ask the creator for a small SOL top-up.`,
+    );
+  }
+
+  // Balance guard
+  const sourceInfo = await conn.getTokenAccountBalance(sourceAta, "confirmed").catch(() => null);
+  const have = BigInt(sourceInfo?.value?.amount ?? "0");
+  if (have < atomic) {
+    throw new Error(`Insufficient USDC: have ${Number(have) / 1e6}, need ${amountUsdc}`);
+  }
+
+  const tx = new Transaction();
+  tx.add(ComputeBudgetProgram.setComputeUnitLimit({ units: 60_000 }));
+
+  if (needsAta) {
+    tx.add(
+      new TransactionInstruction({
+        programId: new PublicKey(ASSOCIATED_TOKEN_PROGRAM_ID),
+        keys: [
+          { pubkey: payer.publicKey, isSigner: true, isWritable: true },
+          { pubkey: destAta, isSigner: false, isWritable: true },
+          { pubkey: dest, isSigner: false, isWritable: false },
+          { pubkey: mint, isSigner: false, isWritable: false },
+          { pubkey: SystemProgram.programId, isSigner: false, isWritable: false },
+          { pubkey: new PublicKey(TOKEN_PROGRAM_ID), isSigner: false, isWritable: false },
+        ],
+        data: Buffer.from([1]), // CreateIdempotent
+      }),
+    );
+  }
+
+  const data = new Uint8Array(1 + 8 + 1);
+  data[0] = 12; // TransferChecked
+  data.set(encodeU64LE(atomic), 1);
+  data[9] = USDC_DECIMALS;
+  tx.add(
+    new TransactionInstruction({
+      programId: new PublicKey(TOKEN_PROGRAM_ID),
+      keys: [
+        { pubkey: sourceAta, isSigner: false, isWritable: true },
+        { pubkey: mint, isSigner: false, isWritable: false },
+        { pubkey: destAta, isSigner: false, isWritable: true },
+        { pubkey: payer.publicKey, isSigner: true, isWritable: false },
+      ],
+      data: Buffer.from(data),
+    }),
+  );
+
+  if (memo) {
+    tx.add(
+      new TransactionInstruction({
+        programId: new PublicKey(MEMO_PROGRAM_ID),
+        keys: [{ pubkey: payer.publicKey, isSigner: true, isWritable: false }],
+        data: Buffer.from(memo.slice(0, 200), "utf-8"),
+      }),
+    );
+  }
+
+  const { blockhash, lastValidBlockHeight } = await conn.getLatestBlockhash("confirmed");
+  tx.recentBlockhash = blockhash;
+  tx.feePayer = payer.publicKey;
+  tx.sign(payer);
+
+  const signature = await conn.sendRawTransaction(tx.serialize(), {
+    skipPreflight: false,
+    maxRetries: 3,
+  });
+  const conf = await conn.confirmTransaction({ signature, blockhash, lastValidBlockHeight }, "confirmed");
+  if (conf.value.err) {
+    throw new Error(`Transfer failed on-chain: ${JSON.stringify(conf.value.err)} (sig ${signature})`);
+  }
+
+  const after = await conn.getBalance(payer.publicKey, "confirmed");
+  return { signature, amountUsdc, to, feeLamports: Math.max(0, lamports - after) };
+}
+
+export interface UsdcInflow {
+  signature: string;
+  amountUsdc: number;
+  counterparty: string | null;
+  blockTime: number | null;
+  memo: string | null;
+}
+
+/**
+ * Scan recent transactions of the wallet's USDC ATA and return incoming
+ * transfers newer than `untilSignature` (exclusive). Oldest first.
+ */
+export async function scanUsdcInflows(
+  address: string,
+  env: SolanaEnv,
+  untilSignature?: string,
+  limit: number = 50,
+): Promise<UsdcInflow[]> {
+  const { PublicKey } = await web3();
+  const conn = await getConnection(env);
+  const ata = new PublicKey(await deriveAta(address, env.usdcMint));
+
+  const sigs = await conn.getSignaturesForAddress(
+    ata,
+    { limit, until: untilSignature || undefined },
+    "confirmed",
+  );
+  if (sigs.length === 0) return [];
+
+  const txs = await conn.getParsedTransactions(
+    sigs.map((s) => s.signature),
+    { maxSupportedTransactionVersion: 0, commitment: "confirmed" },
+  );
+
+  const inflows: UsdcInflow[] = [];
+  for (let i = 0; i < txs.length; i++) {
+    const tx = txs[i];
+    const sig = sigs[i];
+    if (!tx || tx.meta?.err) continue;
+    const pre = tx.meta?.preTokenBalances ?? [];
+    const post = tx.meta?.postTokenBalances ?? [];
+    const keys = tx.transaction.message.accountKeys.map((k: any) =>
+      typeof k === "string" ? k : k.pubkey.toBase58(),
+    );
+    const ataIndex = keys.indexOf(ata.toBase58());
+    if (ataIndex < 0) continue;
+
+    const preBal = pre.find((b) => b.accountIndex === ataIndex && b.mint === env.usdcMint);
+    const postBal = post.find((b) => b.accountIndex === ataIndex && b.mint === env.usdcMint);
+    const preAmt = Number(preBal?.uiTokenAmount?.uiAmount ?? 0);
+    const postAmt = Number(postBal?.uiTokenAmount?.uiAmount ?? 0);
+    const delta = postAmt - preAmt;
+    if (delta <= 0) continue;
+
+    // Counterparty: the owner whose USDC balance decreased in this tx
+    let counterparty: string | null = null;
+    for (const p of post) {
+      if (p.mint !== env.usdcMint || p.accountIndex === ataIndex) continue;
+      const before = pre.find((b) => b.accountIndex === p.accountIndex);
+      const d = Number(p.uiTokenAmount?.uiAmount ?? 0) - Number(before?.uiTokenAmount?.uiAmount ?? 0);
+      if (d < 0) {
+        counterparty = (p as any).owner ?? null;
+        break;
+      }
+    }
+
+    let memo: string | null = null;
+    const logs = tx.meta?.logMessages ?? [];
+    for (const l of logs) {
+      const m = l.match(/Program log: Memo \(len \d+\): "(.*)"/);
+      if (m) memo = m[1];
+    }
+
+    inflows.push({
+      signature: sig.signature,
+      amountUsdc: delta,
+      counterparty,
+      blockTime: tx.blockTime ?? sig.blockTime ?? null,
+      memo,
+    });
+  }
+
+  // getSignaturesForAddress returns newest first; we want oldest first
+  return inflows.reverse();
+}
+
+// ─── Native SOL ───────────────────────────────────────────────
+
+export interface TransferSolResult {
+  signature: string;
+  lamports: number;
+  to: string;
+}
+
+/** Transfer native SOL. Refuses to leave less than MIN_FEE_LAMPORTS behind. */
+export async function transferSol(params: {
+  secretKey: Uint8Array;
+  to: string;
+  lamports: number;
+  env: SolanaEnv;
+  memo?: string;
+}): Promise<TransferSolResult> {
+  const { Keypair, PublicKey, Transaction, TransactionInstruction, SystemProgram } = await web3();
+  const { secretKey, to, lamports, env, memo } = params;
+  if (!Number.isInteger(lamports) || lamports <= 0) throw new Error(`Invalid lamports: ${lamports}`);
+  const payer = Keypair.fromSecretKey(secretKey);
+  const conn = await getConnection(env);
+  const balance = await conn.getBalance(payer.publicKey, "confirmed");
+  if (balance - lamports < MIN_FEE_LAMPORTS) {
+    throw new Error(`Refusing SOL transfer: would leave ${balance - lamports} lamports (< ${MIN_FEE_LAMPORTS} fee reserve)`);
+  }
+  const tx = new Transaction().add(
+    SystemProgram.transfer({ fromPubkey: payer.publicKey, toPubkey: new PublicKey(to), lamports }),
+  );
+  if (memo) {
+    tx.add(
+      new TransactionInstruction({
+        programId: new PublicKey(MEMO_PROGRAM_ID),
+        keys: [{ pubkey: payer.publicKey, isSigner: true, isWritable: false }],
+        data: Buffer.from(memo.slice(0, 200), "utf-8"),
+      }),
+    );
+  }
+  const { blockhash, lastValidBlockHeight } = await conn.getLatestBlockhash("confirmed");
+  tx.recentBlockhash = blockhash;
+  tx.feePayer = payer.publicKey;
+  tx.sign(payer);
+  const signature = await conn.sendRawTransaction(tx.serialize(), { maxRetries: 3 });
+  const conf = await conn.confirmTransaction({ signature, blockhash, lastValidBlockHeight }, "confirmed");
+  if (conf.value.err) throw new Error(`SOL transfer failed on-chain: ${JSON.stringify(conf.value.err)} (sig ${signature})`);
+  return { signature, lamports, to };
+}
+
+export interface SolInflow {
+  signature: string;
+  lamports: number;
+  counterparty: string | null;
+  blockTime: number | null;
+}
+
+/**
+ * Scan recent transactions of the wallet itself for incoming native SOL.
+ * Ignores dust below `minLamports` (rent refunds, airdrop noise).
+ */
+export async function scanSolInflows(
+  address: string,
+  env: SolanaEnv,
+  untilSignature?: string,
+  limit: number = 50,
+  minLamports: number = 100_000,
+): Promise<SolInflow[]> {
+  const { PublicKey } = await web3();
+  const conn = await getConnection(env);
+  const owner = new PublicKey(address);
+  const sigs = await conn.getSignaturesForAddress(owner, { limit, until: untilSignature || undefined }, "confirmed");
+  if (sigs.length === 0) return [];
+  const txs = await conn.getParsedTransactions(
+    sigs.map((s) => s.signature),
+    { maxSupportedTransactionVersion: 0, commitment: "confirmed" },
+  );
+  const out: SolInflow[] = [];
+  for (let i = 0; i < txs.length; i++) {
+    const tx = txs[i];
+    const sig = sigs[i];
+    if (!tx || tx.meta?.err) continue;
+    const keys = tx.transaction.message.accountKeys.map((k: any) => (typeof k === "string" ? k : k.pubkey.toBase58()));
+    const idx = keys.indexOf(address);
+    if (idx < 0) continue;
+    const delta = (tx.meta?.postBalances?.[idx] ?? 0) - (tx.meta?.preBalances?.[idx] ?? 0);
+    if (delta < minLamports) continue;
+    // Skip if we signed it ourselves (self-transfers, ATA rent refunds)
+    const signers = tx.transaction.message.accountKeys.filter((k: any) => typeof k !== "string" && k.signer).map((k: any) => k.pubkey.toBase58());
+    if (signers.includes(address)) continue;
+    let counterparty: string | null = null;
+    for (let j = 0; j < keys.length; j++) {
+      if (j === idx) continue;
+      const d = (tx.meta?.postBalances?.[j] ?? 0) - (tx.meta?.preBalances?.[j] ?? 0);
+      if (d < 0 && signers.includes(keys[j])) {
+        counterparty = keys[j];
+        break;
+      }
+    }
+    out.push({ signature: sig.signature, lamports: delta, counterparty, blockTime: tx.blockTime ?? sig.blockTime ?? null });
+  }
+  return out.reverse();
+}
