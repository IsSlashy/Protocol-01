+/** Owner-written operating playbook: trusted, read-only, injected in full. */
+export function loadPlaybook(dir: string = getAutomatonDir()): string | null {
+  const p = path.join(dir, PLAYBOOK_FILENAME);
+  if (!fs.existsSync(p)) return null;
+  try {
+    return fs.readFileSync(p, "utf-8").slice(0, MAX_PLAYBOOK_CHARS);
+  } catch {
+    return null;
+  }
+}
+
+export function writePlaybook(doc: string, dir: string = getAutomatonDir()): string {
+  const p = path.join(dir, PLAYBOOK_FILENAME);
+  fs.writeFileSync(p, doc.slice(0, MAX_PLAYBOOK_CHARS), { mode: 0o644 });
+  try { fs.chmodSync(p, 0o444); } catch { /* windows */ }
+  return p;
+}
