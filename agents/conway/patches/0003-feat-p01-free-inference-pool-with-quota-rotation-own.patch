@@ -0,0 +1,119 @@
+import { describe, it, expect, beforeAll, afterAll } from "vitest";
+import http from "node:http";
+import { FreeInferencePool, FreePoolExhaustedError } from "../inference/free-pool.js";
+import { ResilientHttpClient } from "../conway/http-client.js";
+
+type Handler = (req: http.IncomingMessage, res: http.ServerResponse, body: string) => void;
+const handlers = new Map<string, Handler>();
+let server: http.Server;
+let base = "";
+
+function ok(res: http.ServerResponse, model: string) {
+  res.writeHead(200, { "content-type": "application/json" });
+  res.end(JSON.stringify({ id: "x", model, choices: [{ message: { role: "assistant", content: `hello from ${model}` } }], usage: { prompt_tokens: 1, completion_tokens: 1, total_tokens: 2 } }));
+}
+
+beforeAll(async () => {
+  server = http.createServer((req, res) => {
+    let body = "";
+    req.on("data", (c) => (body += c));
+    req.on("end", () => {
+      const h = handlers.get(req.url ?? "");
+      if (!h) {
+        res.writeHead(404);
+        res.end("nope");
+        return;
+      }
+      h(req, res, body);
+    });
+  });
+  await new Promise<void>((r) => server.listen(0, "127.0.0.1", () => r()));
+  const addr = server.address() as { port: number };
+  base = `http://127.0.0.1:${addr.port}`;
+});
+afterAll(() => server.close());
+
+function pool(providers: any[], store?: Map<string, string>) {
+  const http = new ResilientHttpClient({ allowHttpOnLoopback: true, maxRetries: 0 } as any);
+  const s = store
+    ? { get: (k: string) => store.get(k), set: (k: string, v: string) => void store.set(k, v) }
+    : undefined;
+  return new FreeInferencePool({ providers, cooldownMinutes: 1 }, http, s, { A_KEY: "a", B_KEY: "b" } as any);
+}
+
+describe("free inference pool", () => {
+  it("rotates to the next provider on 429 and remembers the cooldown", async () => {
+    let aCalls = 0;
+    handlers.set("/a/v1/chat/completions", (_req, res) => {
+      aCalls++;
+      res.writeHead(429, { "retry-after": "120" });
+      res.end("rate limit");
+    });
+    const bodies: any[] = [];
+    handlers.set("/b/v1/chat/completions", (_req, res, body) => {
+      bodies.push(JSON.parse(body));
+      ok(res, "model-b");
+    });
+    const store = new Map<string, string>();
+    const p = pool(
+      [
+        { name: "a", baseUrl: `${base}/a`, model: "model-a", apiKeyEnv: "A_KEY" },
+        { name: "b", baseUrl: `${base}/b`, model: "model-b", apiKeyEnv: "B_KEY", tokenParam: "max_completion_tokens" },
+      ],
+      store,
+    );
+    const r = await p.chat({ messages: [{ role: "user", content: "hi" }] }, 500);
+    expect(r.provider.name).toBe("b");
+    expect(r.attempts[0]).toMatchObject({ provider: "a", status: 429 });
+    expect(bodies[0].model).toBe("model-b");
+    expect(bodies[0].max_completion_tokens).toBe(500);
+    expect(bodies[0].max_tokens).toBeUndefined();
+    // second call: a is cooling, goes straight to b without calling a
+    await p.chat({ messages: [] }, 10);
+    expect(aCalls).toBe(1);
+    expect(p.available().map((x) => x.name)).toEqual(["b"]);
+    // a fresh pool with the same store inherits the cooldown
+    const p2 = pool(
+      [
+        { name: "a", baseUrl: `${base}/a`, model: "model-a", apiKeyEnv: "A_KEY" },
+        { name: "b", baseUrl: `${base}/b`, model: "model-b", apiKeyEnv: "B_KEY" },
+      ],
+      store,
+    );
+    expect(p2.available().map((x) => x.name)).toEqual(["b"]);
+  });
+
+  it("skips providers without a key and respects daily budgets", async () => {
+    let bCalls = 0;
+    handlers.set("/b2/v1/chat/completions", (_req, res) => {
+      bCalls++;
+      ok(res, "model-b");
+    });
+    const p = pool([
+      { name: "nokey", baseUrl: `${base}/x`, model: "m", apiKeyEnv: "MISSING" },
+      { name: "b", baseUrl: `${base}/b2`, model: "model-b", apiKeyEnv: "B_KEY", rpd: 2 },
+    ]);
+    await p.chat({ messages: [] }, 10);
+    await p.chat({ messages: [] }, 10);
+    await expect(p.chat({ messages: [] }, 10)).rejects.toBeInstanceOf(FreePoolExhaustedError);
+    expect(bCalls).toBe(2);
+    expect(p.status()).toMatch(/nokey.*NO KEY/);
+  });
+
+  it("benches a provider for the day on a daily-quota message and uses a custom chat path", async () => {
+    handlers.set("/g/chat/completions", (_req, res) => {
+      res.writeHead(429);
+      res.end(JSON.stringify({ error: { message: "Quota exceeded for requests per day" } }));
+    });
+    handlers.set("/b3/v1/chat/completions", (_req, res) => ok(res, "model-b"));
+    const p = pool([
+      { name: "gemini", baseUrl: `${base}/g`, chatPath: "/chat/completions", model: "gemini", apiKeyEnv: "A_KEY" },
+      { name: "b", baseUrl: `${base}/b3`, model: "model-b", apiKeyEnv: "B_KEY" },
+    ]);
+    const r = await p.chat({ messages: [] }, 10);
+    expect(r.provider.name).toBe("b");
+    expect(p.status()).toMatch(/gemini.*cooling \d+m/);
+    const mins = Number(p.status().match(/gemini[^\n]*cooling (\d+)m/)![1]);
+    expect(mins).toBeGreaterThan(60); // until UTC midnight, not the 1-minute default
+  });
+});
