@@ -0,0 +1,250 @@
+/**
+ * Free inference pool
+ *
+ * Free API tiers (Groq, Cerebras, Google AI Studio, OpenRouter :free models,
+ * Mistral, NVIDIA NIM…) are individually too small and too flaky to keep an
+ * always-on agent alive, but together they are plenty. This pool presents them
+ * as ONE OpenAI-compatible backend:
+ *
+ *   - providers are tried in order; each has its own model id, base URL,
+ *     chat path, token-parameter style and soft per-minute / per-day budgets
+ *   - a provider that answers 429 / 402 / 403 / 5xx or a quota message goes
+ *     into cooldown (Retry-After honoured, daily-quota until UTC midnight)
+ *   - budgets and cooldowns persist in the automaton's KV so restarts do not
+ *     hammer a provider that was already exhausted
+ *   - cost is 0 cents by construction; the runway report reflects that
+ */
+
+import type { ResilientHttpClient } from "../conway/http-client.js";
+
+export interface FreeProvider {
+  name: string;
+  baseUrl: string;
+  /** Path appended to baseUrl. Default "/v1/chat/completions". */
+  chatPath?: string;
+  model: string;
+  /** Env var holding the API key (preferred), or the key itself. */
+  apiKeyEnv?: string;
+  apiKey?: string;
+  /** Soft budgets; the pool rotates before the provider says no. */
+  rpm?: number;
+  rpd?: number;
+  tokenParam?: "max_tokens" | "max_completion_tokens";
+  /** Extra headers (OpenRouter likes HTTP-Referer / X-Title). */
+  headers?: Record<string, string>;
+  enabled?: boolean;
+}
+
+export interface FreePoolConfig {
+  providers: FreeProvider[];
+  /** Cooldown after a non-quota failure (minutes). Default 10. */
+  cooldownMinutes?: number;
+}
+
+export interface FreePoolStateStore {
+  get(key: string): string | undefined;
+  set(key: string, value: string): void;
+}
+
+interface ProviderState {
+  coolingUntil: number;
+  minuteStart: number;
+  minuteCount: number;
+  day: string;
+  dayCount: number;
+  lastError?: string;
+  successes: number;
+  failures: number;
+}
+
+export interface FreePoolAttempt {
+  provider: string;
+  status?: number;
+  error?: string;
+  skipped?: string;
+}
+
+export class FreePoolExhaustedError extends Error {
+  constructor(public attempts: FreePoolAttempt[]) {
+    super(
+      "Free inference pool exhausted: " +
+        attempts.map((a) => `${a.provider}: ${a.skipped ?? a.error ?? a.status}`).join("; "),
+    );
+  }
+}
+
+const KV_PREFIX = "free_pool_state:";
+
+function todayUtc(): string {
+  return new Date().toISOString().slice(0, 10);
+}
+function nextUtcMidnight(): number {
+  const d = new Date();
+  return Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), d.getUTCDate() + 1);
+}
+
+export class FreeInferencePool {
+  private states = new Map<string, ProviderState>();
+
+  constructor(
+    private config: FreePoolConfig,
+    private http: ResilientHttpClient,
+    private store?: FreePoolStateStore,
+    private env: NodeJS.ProcessEnv = process.env,
+  ) {}
+
+  providers(): FreeProvider[] {
+    return this.config.providers.filter((p) => p.enabled !== false);
+  }
+
+  private state(p: FreeProvider): ProviderState {
+    let s = this.states.get(p.name);
+    if (!s) {
+      const raw = this.store?.get(KV_PREFIX + p.name);
+      s = raw ? (JSON.parse(raw) as ProviderState) : { coolingUntil: 0, minuteStart: 0, minuteCount: 0, day: todayUtc(), dayCount: 0, successes: 0, failures: 0 };
+      this.states.set(p.name, s);
+    }
+    if (s.day !== todayUtc()) {
+      s.day = todayUtc();
+      s.dayCount = 0;
+    }
+    return s;
+  }
+
+  private persist(p: FreeProvider, s: ProviderState): void {
+    try {
+      this.store?.set(KV_PREFIX + p.name, JSON.stringify(s));
+    } catch {
+      /* ignore */
+    }
+  }
+
+  private keyFor(p: FreeProvider): string | undefined {
+    if (p.apiKey) return p.apiKey;
+    if (p.apiKeyEnv) return this.env[p.apiKeyEnv] || undefined;
+    return undefined;
+  }
+
+  /** Human-readable status for tools/prompts. */
+  status(): string {
+    const now = Date.now();
+    return this.providers()
+      .map((p) => {
+        const s = this.state(p);
+        const key = this.keyFor(p) ? "key" : "NO KEY";
+        const cool = s.coolingUntil > now ? `cooling ${Math.ceil((s.coolingUntil - now) / 60_000)}m` : "ready";
+        return `${p.name}(${p.model}): ${key}, ${cool}, today ${s.dayCount}${p.rpd ? "/" + p.rpd : ""}, ok ${s.successes} / fail ${s.failures}${s.lastError ? ", last: " + s.lastError.slice(0, 60) : ""}`;
+      })
+      .join("\n");
+  }
+
+  /** Providers usable right now (has key, not cooling, under budgets). */
+  available(): FreeProvider[] {
+    const now = Date.now();
+    return this.providers().filter((p) => {
+      if (!this.keyFor(p)) return false;
+      const s = this.state(p);
+      if (s.coolingUntil > now) return false;
+      if (p.rpd && s.dayCount >= p.rpd) return false;
+      if (p.rpm && now - s.minuteStart < 60_000 && s.minuteCount >= p.rpm) return false;
+      return true;
+    });
+  }
+
+  private cool(p: FreeProvider, s: ProviderState, ms: number, why: string): void {
+    s.coolingUntil = Math.max(s.coolingUntil, Date.now() + ms);
+    s.failures++;
+    s.lastError = why;
+    this.persist(p, s);
+  }
+
+  /**
+   * Send one chat completion through the first available provider.
+   * `body` is an OpenAI-style request without `model`/token param.
+   */
+  async chat(body: Record<string, unknown>, tokenLimit: number): Promise<{ data: any; provider: FreeProvider; attempts: FreePoolAttempt[] }> {
+    const attempts: FreePoolAttempt[] = [];
+    const now = Date.now();
+    for (const p of this.providers()) {
+      const s = this.state(p);
+      const key = this.keyFor(p);
+      if (!key) {
+        attempts.push({ provider: p.name, skipped: "no api key" });
+        continue;
+      }
+      if (s.coolingUntil > now) {
+        attempts.push({ provider: p.name, skipped: `cooling until ${new Date(s.coolingUntil).toISOString()}` });
+        continue;
+      }
+      if (p.rpd && s.dayCount >= p.rpd) {
+        attempts.push({ provider: p.name, skipped: `daily budget ${p.rpd} used` });
+        continue;
+      }
+      if (now - s.minuteStart >= 60_000) {
+        s.minuteStart = now;
+        s.minuteCount = 0;
+      }
+      if (p.rpm && s.minuteCount >= p.rpm) {
+        attempts.push({ provider: p.name, skipped: `minute budget ${p.rpm} used` });
+        continue;
+      }
+
+      const req: Record<string, unknown> = { ...body, model: p.model };
+      req[p.tokenParam ?? "max_tokens"] = tokenLimit;
+      const url = p.baseUrl.replace(/[/]+$/, "") + (p.chatPath ?? "/v1/chat/completions");
+      s.minuteCount++;
+      s.dayCount++;
+
+      let resp: Response;
+      try {
+        resp = await this.http.request(url, {
+          method: "POST",
+          headers: { "Content-Type": "application/json", Authorization: `Bearer ${key}`, ...(p.headers ?? {}) },
+          body: JSON.stringify(req),
+          retries: 0,
+        });
+      } catch (err: any) {
+        this.cool(p, s, (this.config.cooldownMinutes ?? 10) * 60_000, `network: ${err?.message ?? err}`);
+        attempts.push({ provider: p.name, error: err?.message ?? String(err) });
+        continue;
+      }
+
+      if (resp.ok) {
+        let data: any;
+        try {
+          data = await resp.json();
+        } catch (err: any) {
+          this.cool(p, s, 5 * 60_000, "bad json");
+          attempts.push({ provider: p.name, error: "bad json" });
+          continue;
+        }
+        if (!data?.choices?.[0]?.message) {
+          this.cool(p, s, 5 * 60_000, "no choices");
+          attempts.push({ provider: p.name, error: "no choices" });
+          continue;
+        }
+        s.successes++;
+        this.persist(p, s);
+        return { data, provider: p, attempts };
+      }
+
+      const text = await resp.text().catch(() => "");
+      const status = resp.status;
+      const retryAfter = Number(resp.headers.get("retry-after"));
+      const daily = /per day|daily|quota exceeded|RPD|tokens per day|TPD/i.test(text);
+      let ms: number;
+      if (status === 429) {
+        ms = daily ? nextUtcMidnight() - Date.now() : Number.isFinite(retryAfter) && retryAfter > 0 ? retryAfter * 1000 : 60_000;
+      } else if (status === 402 || status === 403 || status === 401) {
+        ms = 6 * 3_600_000; // out of credit / key issue: leave it alone for a while
+      } else if (status === 400 && /model|not found|does not exist|decommissioned/i.test(text)) {
+        ms = 24 * 3_600_000; // wrong model id: stop wasting calls until someone fixes it
+      } else {
+        ms = (this.config.cooldownMinutes ?? 10) * 60_000;
+      }
+      this.cool(p, s, ms, `${status}: ${text.slice(0, 120)}`);
+      attempts.push({ provider: p.name, status, error: text.slice(0, 120) });
+    }
+    throw new FreePoolExhaustedError(attempts);
+  }
+}
