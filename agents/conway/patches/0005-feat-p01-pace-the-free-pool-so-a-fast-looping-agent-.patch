+  private paceState(): { lastCallAt: number; day: string; dayCount: number } {
+    if (!this.pace) {
+      const raw = this.store?.get(KV_PACE);
+      this.pace = raw ? JSON.parse(raw) : { lastCallAt: 0, day: todayUtc(), dayCount: 0 };
+    }
+    if (this.pace!.day !== todayUtc()) {
+      this.pace = { lastCallAt: this.pace!.lastCallAt, day: todayUtc(), dayCount: 0 };
+    }
+    return this.pace!;
+  }
+
+  private savePace(): void {
+    try {
+      this.store?.set(KV_PACE, JSON.stringify(this.pace));
+    } catch {
+      /* ignore */
+    }
+  }
+
+  /** Milliseconds the next call must wait for the configured pace. */
+  waitMs(): number {
+    const paceMs = this.config.paceMs ?? 0;
+    if (paceMs <= 0) return 0;
+    const p = this.paceState();
+    return Math.max(0, p.lastCallAt + paceMs - Date.now());
+  }
+
+  callsToday(): number {
+    return this.paceState().dayCount;
+  }
+
   /** Human-readable status for tools/prompts. */
   status(): string {
     const now = Date.now();
