   async chat(body: Record<string, unknown>, tokenLimit: number): Promise<{ data: any; provider: FreeProvider; attempts: FreePoolAttempt[] }> {
     const attempts: FreePoolAttempt[] = [];
+
+    // Global daily ceiling across the whole pool.
+    const pace = this.paceState();
+    const maxDay = this.config.maxCallsPerDay ?? 0;
+    if (maxDay > 0 && pace.dayCount >= maxDay) {
+      throw new FreePoolExhaustedError([
+        { provider: "pool", skipped: `daily ceiling ${maxDay} reached (${pace.dayCount} calls today)` },
+      ]);
+    }
+
+    // Pace: wait rather than fail, so a fast-looping agent cannot burn the
+    // day's free quota in an hour.
+    const wait = this.waitMs();
+    if (wait > 0) await new Promise((r) => setTimeout(r, wait));
+    pace.lastCallAt = Date.now();
+    pace.dayCount++;
+    this.savePace();
