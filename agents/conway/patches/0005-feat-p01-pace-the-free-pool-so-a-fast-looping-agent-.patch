+    if (paceMs) parts.push(`pace ${Math.round(paceMs / 1000)}s between calls (next in ${Math.ceil(this.waitMs() / 1000)}s)`);
+    if (maxDay) parts.push(`pool calls today ${p.dayCount}/${maxDay}`);
+    return "\n" + parts.join(" | ");
   }
 
