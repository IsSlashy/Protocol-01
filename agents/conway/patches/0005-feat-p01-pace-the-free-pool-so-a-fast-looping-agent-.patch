@@ -117,3 +117,26 @@ describe("free inference pool", () => {
     expect(mins).toBeGreaterThan(60); // until UTC midnight, not the 1-minute default
   });
 });
+
+describe("free pool pacing", () => {
+  it("waits between calls instead of failing, and enforces a daily ceiling", async () => {
+    handlers.set("/p/v1/chat/completions", (_req, res) => ok(res, "model-p"));
+    const store = new Map<string, string>();
+    const httpc = new ResilientHttpClient({ allowHttpOnLoopback: true, maxRetries: 0 } as any);
+    const providers = [{ name: "p", baseUrl: `${base}/p`, model: "model-p", apiKeyEnv: "A_KEY" }];
+    const s = { get: (k: string) => store.get(k), set: (k: string, v: string) => void store.set(k, v) };
+    const p = new FreeInferencePool({ providers, paceMs: 250 }, httpc, s, { A_KEY: "a" } as any);
+
+    const t0 = Date.now();
+    await p.chat({ messages: [] }, 10);
+    await p.chat({ messages: [] }, 10);
+    expect(Date.now() - t0).toBeGreaterThanOrEqual(200);
+    expect(p.callsToday()).toBe(2);
+    expect(p.status()).toMatch(/pace 0s|pace 1s|pool calls today 2/);
+
+    // A fresh pool sharing the store keeps the pace and the day counter.
+    const p2 = new FreeInferencePool({ providers, paceMs: 250, maxCallsPerDay: 2 }, httpc, s, { A_KEY: "a" } as any);
+    expect(p2.callsToday()).toBe(2);
+    await expect(p2.chat({ messages: [] }, 10)).rejects.toThrow(/daily ceiling 2/);
+  });
+});
