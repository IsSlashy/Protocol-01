+describe("free inference and survival tier", () => {
+  it("keeps the agent at normal tier with an empty wallet when inference is free", async () => {
+    const { getEffectiveSurvivalTier } = await import("../economy/runway.js");
+    const base: any = { chainType: "solana", creatorAddress: "x" };
+    expect(getEffectiveSurvivalTier(base, 0, 0)).toBe("critical");
+    const withPool: any = { ...base, freePool: { providers: [{ name: "p", baseUrl: "u", model: "m" }] } };
