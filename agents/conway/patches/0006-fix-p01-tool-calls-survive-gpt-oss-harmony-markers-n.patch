diff --git a/src/conway/inference.ts b/src/conway/inference.ts
index ad6bc1c..9e6a6a6 100644
--- a/src/conway/inference.ts
+++ b/src/conway/inference.ts
@@ -262,6 +262,55 @@ async function chatViaOpenAiCompatible(params: {
   return parseOpenAiCompletion(data, params.model);
 }
 
+/**
+ * Strip provider control markers from a value.
+ * gpt-oss "harmony" models emit things like `check_credits<|channel|>commentary`.
+ */
+export function stripHarmonyMarkers(raw: string): string {
+  let s = String(raw ?? "");
+  const cut = s.indexOf("<|");
+  if (cut >= 0) s = s.slice(0, cut);
+  return s.replace(/<\|[^|]*\|>/g, "").trim();
+}
+
+/** Clean a tool name: keep the identifier, drop anything a provider appended. */
+export function sanitizeToolName(raw: string): string {
+  const first = stripHarmonyMarkers(raw).split("\n")[0].trim();
+  const m = first.match(/[A-Za-z_][A-Za-z0-9_.-]*/);
+  return m ? m[0] : first;
+}
+
+/** Clean tool arguments and guarantee parseable JSON (falls back to "{}"). */
+export function sanitizeToolArguments(raw: unknown): string {
+  if (raw && typeof raw === "object") {
+    try {
+      return JSON.stringify(raw);
+    } catch {
+      return "{}";
+    }
+  }
+  const s = stripHarmonyMarkers(typeof raw === "string" ? raw : "");
+  if (!s) return "{}";
+  try {
+    JSON.parse(s);
+    return s;
+  } catch {
+    /* try to recover a balanced object below */
+  }
+  const start = s.indexOf("{");
+  const end = s.lastIndexOf("}");
+  if (start >= 0 && end > start) {
+    const candidate = s.slice(start, end + 1);
+    try {
+      JSON.parse(candidate);
+      return candidate;
+    } catch {
+      /* give up */
+    }
+  }
+  return "{}";
+}
+
 /** Map an OpenAI-style chat completion into the runtime's InferenceResponse. */
 function parseOpenAiCompletion(data: any, modelLabel: string): InferenceResponse {
   const choice = data.choices?.[0];
@@ -282,8 +331,8 @@ function parseOpenAiCompletion(data: any, modelLabel: string): InferenceResponse
       id: tc.id,
       type: "function" as const,
       function: {
-        name: tc.function.name,
-        arguments: tc.function.arguments,
+        name: sanitizeToolName(tc.function?.name),
+        arguments: sanitizeToolArguments(tc.function?.arguments),
       },
     }));
 
@@ -292,7 +341,7 @@ function parseOpenAiCompletion(data: any, modelLabel: string): InferenceResponse
     model: data.model || modelLabel,
     message: {
       role: message.role,
-      content: message.content || "",
+      content: stripHarmonyMarkers(message.content || ""),
       tool_calls: toolCalls,
     },
     toolCalls,
@@ -364,8 +413,8 @@ async function chatViaAnthropic(params: {
