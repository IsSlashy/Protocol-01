@@ -39,8 +39,18 @@ export function getEffectiveSurvivalTier(
   usdcBalance: number,
 ): SurvivalTier {
   const credits = creditsCents < 0 ? 0 : creditsCents;
-  if (!usdcCountsAsRunway(config)) return getSurvivalTier(creditsCents);
   const usdcCents = usdcBalance > 0 ? Math.floor(usdcBalance * 100) : 0;
+
+  // p01: with a free inference pool, thinking costs nothing, so an empty
+  // wallet must not put the agent in low-compute or dead. It still dies of
+  // uselessness — the supervisor kills a lineage that earns nothing — but not
+  // of an empty balance it does not need.
+  if (config.freePool?.providers?.length) {
+    const rich = getSurvivalTier(credits + usdcCents);
+    return rich === "high" ? "high" : "normal";
+  }
+
+  if (!usdcCountsAsRunway(config)) return getSurvivalTier(creditsCents);
   return getSurvivalTier(credits + usdcCents);
 }
 
