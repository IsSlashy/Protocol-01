# Copy to agents/conway/.env (git-ignored). The supervisor loads it and passes
# the relevant variables to every agent process.

# ── Free inference pool (colony.json inference.provider = "free-pool") ──
# Create free accounts, paste the keys. Any subset works; more keys = more
# daily capacity. See agents/conway/free-providers.json for the order/models.
GROQ_API_KEY=            # https://console.groq.com/keys
CEREBRAS_API_KEY=        # https://cloud.cerebras.ai (2026-09-03: 402 payment required; entry disabled)
GEMINI_API_KEY=          # https://aistudio.google.com/apikey (2026-09-03: project denied access; entry disabled until fixed)
NVIDIA_API_KEY=          # https://build.nvidia.com (API keys)
MISTRAL_API_KEY=         # https://console.mistral.ai (free "Experiment" tier)
OPENROUTER_API_KEY=      # https://openrouter.ai/keys (50 req/day free, 1000 after a one-off $10 credit)

# ── Paid inference (colony.json inference.provider = "anthropic") ──
# ANTHROPIC_API_KEY=

# ── Solana ──
# Mainnet RPC used by the agents and the supervisor. A Helius mainnet URL is
# recommended; the public endpoint rate-limits inflow scans.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ── Conway (optional) ──
# API key for the agents. Solana Sign-In provisioning is broken server-side at
# the moment (500), so provide a key created from a Conway account if you want
# sandboxes/domains. Without it the agents run on the inference pool only.
# CONWAY_API_KEY=

# Optional owner-side funder: EVM private key holding USDC on Base, used to buy
# Conway credits for agents that request them (the pay endpoint is Base-only).
# Only used when colony.json funder.enabled is true.
# FUNDER_EVM_PRIVATE_KEY=0x...

# Optional: SOL/USD price for valuing SOL revenue in reports.
# SOL_USD_PRICE=
