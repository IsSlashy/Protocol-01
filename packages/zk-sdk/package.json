{
  "name": "@protocol-01/zk-sdk",
  "version": "1.0.1",
  "description": "STARK-native, quantum-resistant ZK SDK for Protocol 01 shielded transactions on Solana",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./circuits": {
      "import": "./dist/circuits/index.mjs",
      "require": "./dist/circuits/index.js",
      "types": "./dist/circuits/index.d.ts"
    },
    "./prover": {
      "import": "./dist/prover/index.mjs",
      "require": "./dist/prover/index.js",
      "types": "./dist/prover/index.d.ts"
    },
    "./notes": {
      "import": "./dist/notes/index.mjs",
      "require": "./dist/notes/index.js",
      "types": "./dist/notes/index.d.ts"
    },
    "./merkle": {
      "import": "./dist/merkle/index.mjs",
      "require": "./dist/merkle/index.js",
      "types": "./dist/merkle/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/circuits/index.ts src/notes/index.ts src/merkle/index.ts src/prover/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts src/circuits/index.ts src/notes/index.ts src/merkle/index.ts src/prover/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "solana",
    "protocol-01",
    "privacy",
    "zero-knowledge",
    "zk-stark",
    "post-quantum",
    "shielded",
    "crypto"
  ],
  "author": "Protocol 01 Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/protocol-01/zk-sdk"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@noble/hashes": "^2.2.0",
    "@protocol-01/stark-prover": "workspace:^",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "bn.js": "^5.2.3",
    "bs58": "^6.0.0",
    "poseidon-lite": "^0.3.0",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/bn.js": "^5.2.0",
    "@types/node": "^22.19.19",
    "eslint": "^8.57.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "@protocol-01/privacy-sdk": "workspace:^",
    "@solana/web3.js": "^1.98.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
