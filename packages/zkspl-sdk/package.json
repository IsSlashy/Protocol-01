{
  "name": "@p01/zkspl-sdk",
  "version": "0.1.0",
  "description": "SDK for Protocol 01 zkSPL confidential token balances",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "solana",
    "protocol-01",
    "privacy",
    "zero-knowledge",
    "zk-snark",
    "groth16",
    "confidential",
    "zkspl",
    "poseidon"
  ],
  "author": "Protocol 01 Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/VoltaTeam/protocol-01"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.29.0",
    "@noble/hashes": "^1.3.3",
    "@solana/spl-token": "^0.4.0",
    "@solana/web3.js": "^1.91.0",
    "bn.js": "^5.2.1",
    "poseidon-lite": "^0.2.0",
    "snarkjs": "^0.7.4"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.5",
    "@types/node": "^20.11.0",
    "@types/snarkjs": "^0.7.8",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  },
  "peerDependencies": {
    "@solana/web3.js": "^1.91.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
