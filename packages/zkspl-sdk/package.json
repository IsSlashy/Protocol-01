{
  "name": "@protocol-01/zkspl-sdk",
  "version": "0.1.3",
  "description": "SDK for Protocol 01 zkSPL confidential token balances",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "solana",
    "protocol-01",
    "privacy",
    "zero-knowledge",
    "zk-stark",
    "stark",
    "confidential",
    "zkspl",
    "poseidon"
  ],
  "author": "Protocol 01 Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IsSlashy/Protocol-01.git",
    "directory": "packages/zkspl-sdk"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@noble/hashes": "^2.2.0",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "bn.js": "^5.2.3",
    "poseidon-lite": "^0.3.0"
  },
  "devDependencies": {
    "@types/bn.js": "^5.2.0",
    "@types/node": "^22.19.19",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "@solana/web3.js": "^1.98.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
