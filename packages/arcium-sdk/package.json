      "types": "./dist/registry/index.d.ts"
    },
    "./nullifier": {
      "import": "./dist/nullifier/index.mjs",
      "require": "./dist/nullifier/index.js",
      "types": "./dist/nullifier/index.d.ts"
    },
    "./audit": {
