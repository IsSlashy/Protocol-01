{
  "name": "@protocol-01/specter-sdk",
  "version": "0.4.3",
  "description": "TypeScript SDK for interacting with Protocol 01 - Privacy-preserving payments on Solana",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.mts",
        "default": "./dist/core.mjs"
      },
      "require": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      }
    },
    "./wallet": {
      "import": {
        "types": "./dist/wallet/index.d.mts",
        "default": "./dist/wallet/index.mjs"
      },
      "require": {
        "types": "./dist/wallet/index.d.ts",
        "default": "./dist/wallet/index.js"
      }
    },
    "./stealth": {
      "import": {
        "types": "./dist/stealth/index.d.mts",
        "default": "./dist/stealth/index.mjs"
      },
      "require": {
        "types": "./dist/stealth/index.d.ts",
        "default": "./dist/stealth/index.js"
      }
    },
    "./transfer": {
      "import": {
        "types": "./dist/transfer/index.d.mts",
        "default": "./dist/transfer/index.mjs"
      },
      "require": {
        "types": "./dist/transfer/index.d.ts",
        "default": "./dist/transfer/index.js"
      }
    },
    "./streams": {
      "import": {
        "types": "./dist/streams/index.d.mts",
        "default": "./dist/streams/index.mjs"
      },
      "require": {
        "types": "./dist/streams/index.d.ts",
        "default": "./dist/streams/index.js"
      }
    },
    "./proving": {
      "import": {
        "types": "./dist/proving/index.d.mts",
        "default": "./dist/proving/index.mjs"
      },
      "require": {
        "types": "./dist/proving/index.d.ts",
        "default": "./dist/proving/index.js"
      }
    },
    "./indexing": {
      "import": {
        "types": "./dist/indexing/index.d.mts",
        "default": "./dist/indexing/index.mjs"
      },
      "require": {
        "types": "./dist/indexing/index.d.ts",
        "default": "./dist/indexing/index.js"
      }
    },
    "./relay": {
      "import": {
        "types": "./dist/relay/index.d.mts",
        "default": "./dist/relay/index.mjs"
      },
      "require": {
        "types": "./dist/relay/index.d.ts",
        "default": "./dist/relay/index.js"
      }
    },
    "./service-registry": {
      "import": {
        "types": "./dist/service-registry/index.d.mts",
        "default": "./dist/service-registry/index.mjs"
      },
      "require": {
        "types": "./dist/service-registry/index.d.ts",
        "default": "./dist/service-registry/index.js"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "wasm"
  ],
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "build:core": "tsup src/core.ts --format cjs,esm --dts --no-clean --out-dir dist",
    "dev": "tsup --config tsup.config.ts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "solana",
    "protocol-01",
    "privacy",
    "stealth-address",
    "crypto",
    "blockchain",
    "web3",
    "zero-knowledge",
    "zk-stark",
    "stark",
    "post-quantum"
  ],
  "author": "Protocol 01 Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IsSlashy/Protocol-01.git",
    "directory": "packages/specter-sdk"
  },
  "dependencies": {
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@noble/post-quantum": "^0.6.1",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "bip39": "^3.1.0",
    "bs58": "^6.0.0",
    "ed25519-hd-key": "^1.3.0",
    "poseidon-lite": "^0.3.0",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "eslint": "^8.57.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "@protocol-01/stark-prover": "workspace:^"
  },
  "peerDependencies": {
    "@solana/web3.js": "^1.98.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "typesVersions": {
    "*": {
      "core": [
        "./dist/core.d.ts"
      ],
      "wallet": [
        "./dist/wallet/index.d.ts"
      ],
      "stealth": [
        "./dist/stealth/index.d.ts"
      ],
      "transfer": [
        "./dist/transfer/index.d.ts"
      ],
      "streams": [
        "./dist/streams/index.d.ts"
      ],
      "proving": [
        "./dist/proving/index.d.ts"
      ],
      "indexing": [
        "./dist/indexing/index.d.ts"
      ],
      "relay": [
        "./dist/relay/index.d.ts"
      ],
      "service-registry": [
        "./dist/service-registry/index.d.ts"
      ]
    }
  }
}
