{
  "name": "@protocol-01/specter-sdk",
  "version": "0.4.1",
  "description": "TypeScript SDK for interacting with Protocol 01 - Privacy-preserving payments on Solana",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./core": {
      "import": "./dist/core.mjs",
      "require": "./dist/core.js",
      "types": "./dist/core.d.ts"
    },
    "./wallet": {
      "import": "./dist/wallet/index.mjs",
      "require": "./dist/wallet/index.js",
      "types": "./dist/wallet/index.d.ts"
    },
    "./stealth": {
      "import": "./dist/stealth/index.mjs",
      "require": "./dist/stealth/index.js",
      "types": "./dist/stealth/index.d.ts"
    },
    "./transfer": {
      "import": "./dist/transfer/index.mjs",
      "require": "./dist/transfer/index.js",
      "types": "./dist/transfer/index.d.ts"
    },
    "./streams": {
      "import": "./dist/streams/index.mjs",
      "require": "./dist/streams/index.js",
      "types": "./dist/streams/index.d.ts"
    },
    "./proving": {
      "import": "./dist/proving/index.mjs",
      "require": "./dist/proving/index.js",
      "types": "./dist/proving/index.d.ts"
    },
    "./indexing": {
      "import": "./dist/indexing/index.mjs",
      "require": "./dist/indexing/index.js",
      "types": "./dist/indexing/index.d.ts"
    },
    "./relay": {
      "import": "./dist/relay/index.mjs",
      "require": "./dist/relay/index.js",
      "types": "./dist/relay/index.d.ts"
    },
    "./service-registry": {
      "import": "./dist/service-registry/index.mjs",
      "require": "./dist/service-registry/index.js",
      "types": "./dist/service-registry/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/core.ts src/wallet/index.ts src/stealth/index.ts src/transfer/index.ts src/streams/index.ts src/proving/index.ts src/indexing/index.ts src/relay/index.ts src/service-registry/index.ts --format cjs,esm --dts --clean --out-dir dist",
    "build:core": "tsup src/core.ts --format cjs,esm --dts --out-dir dist",
    "dev": "tsup src/index.ts src/core.ts src/wallet/index.ts src/stealth/index.ts src/transfer/index.ts src/streams/index.ts src/proving/index.ts src/indexing/index.ts src/relay/index.ts src/service-registry/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "solana",
    "protocol-01",
    "privacy",
    "stealth-address",
    "crypto",
    "blockchain",
    "web3",
    "zero-knowledge",
    "zk-stark",
    "stark",
    "post-quantum"
  ],
  "author": "Protocol 01 Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/protocol-01/sdk"
  },
  "dependencies": {
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@noble/post-quantum": "^0.6.1",
    "@protocol-01/stark-prover": "workspace:^",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "bip39": "^3.1.0",
    "bs58": "^6.0.0",
    "ed25519-hd-key": "^1.3.0",
    "poseidon-lite": "^0.3.0",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "eslint": "^8.57.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "@solana/web3.js": "^1.98.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
