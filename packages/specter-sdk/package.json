{
  "name": "@p01/specter-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for interacting with Protocol 01 - Privacy-preserving payments on Solana",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./wallet": {
      "import": "./dist/wallet/index.mjs",
      "require": "./dist/wallet/index.js",
      "types": "./dist/wallet/index.d.ts"
    },
    "./stealth": {
      "import": "./dist/stealth/index.mjs",
      "require": "./dist/stealth/index.js",
      "types": "./dist/stealth/index.d.ts"
    },
    "./transfer": {
      "import": "./dist/transfer/index.mjs",
      "require": "./dist/transfer/index.js",
      "types": "./dist/transfer/index.d.ts"
    },
    "./streams": {
      "import": "./dist/streams/index.mjs",
      "require": "./dist/streams/index.js",
      "types": "./dist/streams/index.d.ts"
    },
    "./proving": {
      "import": "./dist/proving/index.mjs",
      "require": "./dist/proving/index.js",
      "types": "./dist/proving/index.d.ts"
    },
    "./indexing": {
      "import": "./dist/indexing/index.mjs",
      "require": "./dist/indexing/index.js",
      "types": "./dist/indexing/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "solana",
    "protocol-01",
    "privacy",
    "stealth-address",
    "crypto",
    "blockchain",
    "web3",
    "zero-knowledge",
    "zk-snark",
    "groth16"
  ],
  "author": "Protocol 01 Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/protocol-01/sdk"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@noble/hashes": "^1.7.1",
    "@noble/post-quantum": "^0.2.1",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "bip39": "^3.1.0",
    "bs58": "^6.0.0",
    "ed25519-hd-key": "^1.3.0",
    "poseidon-lite": "^0.3.0",
    "snarkjs": "^0.7.5",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/snarkjs": "^0.7.8",
    "eslint": "^8.56.0",
    "tsup": "^8.4.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "peerDependencies": {
    "@solana/web3.js": "^1.98.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
