{
  "name": "@protocol-01/stark-prover",
  "version": "0.2.0",
  "description": "Quantum-resistant STARK prover for Protocol 01 — drop-in WASM-backed proof generator + on-chain verifier submitter for @protocol-01/privacy-sdk. No trusted setup, no elliptic curves, post-quantum safe.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./wasm-loader": {
      "types": "./dist/wasm-loader.d.ts",
      "import": "./dist/wasm-loader.mjs",
      "require": "./dist/wasm-loader.js"
    },
    "./upload-protocol": {
      "types": "./dist/upload-protocol.d.ts",
      "import": "./dist/upload-protocol.mjs",
      "require": "./dist/upload-protocol.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.mjs",
      "require": "./dist/types.js"
    },
    "./wasm/p01_stark_bg.wasm": "./wasm/p01_stark_bg.wasm",
    "./wasm/p01_stark.js": "./wasm/p01_stark.js"
  },
  "files": [
    "dist",
    "src",
    "wasm"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "check:deployed": "node scripts/deployed-verifier-check.mjs",
    "check:deployed:onchain": "node scripts/deployed-verifier-check.mjs --verify-onchain",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "solana",
    "protocol-01",
    "privacy",
    "stark",
    "zk-stark",
    "post-quantum",
    "quantum-resistant",
    "wasm",
    "zero-knowledge",
    "proof-system"
  ],
  "author": "Protocol 01 Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IsSlashy/Protocol-01.git",
    "directory": "packages/stark-prover"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@protocol-01/privacy-sdk": "workspace:*",
    "@solana/web3.js": "^1.98.4",
    "@types/node": "^22.19.19",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "@protocol-01/privacy-sdk": "workspace:^",
    "@solana/web3.js": "^1.98.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
