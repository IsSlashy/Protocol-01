{
  "name": "@protocol-01/p01-js",
  "version": "0.3.2",
  "description": "Drop-in merchant SDK for Protocol 01 — privacy-first crypto payments (post-quantum STARK proofs), Stream Secure subscriptions, vanilla JS + React widgets. Zero-config pay button.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.mjs",
      "require": "./dist/react/index.js"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "import": "./dist/registry.mjs",
      "require": "./dist/registry.js"
    }
  },
  "typesVersions": {
    "*": {
      "react": [
        "dist/react/index.d.ts"
      ],
      "registry": [
        "dist/registry.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "test": "vitest run --config vitest.unit.config.ts",
    "test:watch": "vitest --config vitest.unit.config.ts",
    "prepublishOnly": "pnpm run build && pnpm run test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "keywords": [
    "protocol01",
    "p01",
    "p-01",
    "solana",
    "payments",
    "subscriptions",
    "privacy",
    "crypto",
    "stealth-address",
    "stream-secure",
    "usdc",
    "react",
    "widget",
    "web3",
    "defi",
    "sdk"
  ],
  "author": "Protocol 01 <contact@protocol01.com> (https://protocol01.com)",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@protocol-01/privacy-sdk": "workspace:^",
    "react": ">=17.0.0"
  },
  "peerDependenciesMeta": {
    "@protocol-01/privacy-sdk": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@solana/web3.js": "^1.98.4",
    "@storybook/addon-a11y": "^10.4.1",
    "@storybook/addon-docs": "^10.4.1",
    "@storybook/react-vite": "^10.4.1",
    "@types/node": "^22.19.19",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "rimraf": "^5.0.10",
    "storybook": "^10.4.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@noble/ciphers": "^2.2.0",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@protocol-01/stark-prover": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IsSlashy/Protocol-01.git",
    "directory": "packages/p01-js"
  },
  "bugs": {
    "url": "https://github.com/IsSlashy/Protocol-01/issues"
  },
  "homepage": "https://protocol-01.dev"
}
