{
  "name": "@protocol-01/privacy-sdk",
  "version": "2.0.0",
  "description": "Solana privacy SDK: stealth meta-address registry, privacy relay, denomination split and identity key derivation.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./registry": {
      "types": "./dist/modules/registry.d.ts",
      "import": "./dist/modules/registry.mjs",
      "require": "./dist/modules/registry.js"
    },
    "./relay": {
      "types": "./dist/modules/relay.d.ts",
      "import": "./dist/modules/relay.mjs",
      "require": "./dist/modules/relay.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.mjs",
      "require": "./dist/react/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "solana",
    "privacy",
    "stealth-address",
    "quantum-resistant",
    "protocol-01",
    "web3",
    "sdk"
  ],
  "author": "Protocol 01 Team",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/P-01SDK/privacy-sdk.git"
  },
  "dependencies": {
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@solana/web3.js": "^1.98.4",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "@solana/web3.js": "^1.98.0",
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
