# ============================================================================
# P01 Privacy Relay — Railway Single-Container Deployment
# ============================================================================
#
# Runs BOTH the Bundle Engine (Node.js) and Tor SOCKS5 proxy in one container.
# Tor provides IP anonymization for all outbound RPC traffic.
#
# Deploy on Railway:
#   railway up
#
# Size: ~200MB (Node 22 Alpine + Tor + deps)
# ============================================================================

# ── Stage 1: Build TypeScript ──
FROM node:22-alpine AS builder

WORKDIR /app

COPY package.json pnpm-lock.yaml* ./
RUN corepack enable && \
    if [ -f pnpm-lock.yaml ]; then \
      pnpm install --frozen-lockfile; \
    else \
      npm install; \
    fi

COPY tsconfig.json ./
COPY src/ ./src/
RUN npx tsc

# ── Stage 2: Runtime ──
FROM node:22-alpine

# tini: proper PID 1 signal handling
# tor: SOCKS5 proxy for IP anonymization
# su-exec: lightweight privilege drop (no sudo overhead)
RUN apk add --no-cache tini tor su-exec

# Tor configuration
COPY tor/torrc /etc/tor/torrc
RUN mkdir -p /var/lib/tor && \
    chown tor:tor /var/lib/tor && \
    chmod 700 /var/lib/tor

# Non-root user for the relay process
RUN addgroup -S p01 && adduser -S p01 -G p01

WORKDIR /app

# Copy compiled output + dependencies
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY package.json ./

# Install socks-proxy-agent for Tor SOCKS5 routing
RUN npm install --no-save socks-proxy-agent@8 && \
    npm cache clean --force

# Set ownership
RUN chown -R p01:p01 /app

# Entrypoint script (starts Tor then relay)
# sed strips Windows CRLF line endings (git on Windows may add \r)
COPY entrypoint.sh /entrypoint.sh
RUN sed -i 's/\r$//' /entrypoint.sh && chmod +x /entrypoint.sh

# Railway sets PORT dynamically — our server reads process.env.PORT
EXPOSE 3099

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:${PORT:-3099}/health || exit 1

ENTRYPOINT ["tini", "--"]
CMD ["/entrypoint.sh"]
