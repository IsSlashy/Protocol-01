# ============================================================================
# P01 Privacy Relay — Environment Variables
# ============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================================

# ── Solana RPC ──
# Your upstream Solana RPC endpoint. Helius recommended for reliability.
# The relay routes all traffic through Tor — the RPC provider never sees your IP.
SOLANA_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY

# Optional: separate upstream URL (overrides SOLANA_RPC_URL for the relay)
# UPSTREAM_RPC_URL=

# ── Relay Server ──
# Port to expose the relay on (default: 3099)
RELAY_PORT=3099

# ── Privacy Settings ──
# Random delay added to each RPC request to break timing correlation (ms)
RPC_JITTER_MS=300

# TX accumulation window before batch flush (ms)
BATCH_WINDOW_MS=2000

# ── Rate Limiting ──
# Max requests per minute per client (hashed, no IP stored)
RATE_LIMIT_RPM=120

# ── Tor ──
# Tor SOCKS5 proxy URL. Set automatically in Docker Compose.
# For standalone deployment, install Tor and set:
# TOR_SOCKS_PROXY=socks5h://127.0.0.1:9050
